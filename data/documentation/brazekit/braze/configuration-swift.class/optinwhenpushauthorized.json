{"sections":[],"abstract":[{"text":"Specifies if the SDK will automatically report a user’s notification subscription state as ","type":"text"},{"code":"optedIn","type":"codeVoice"},{"text":" ","type":"text"},{"text":"when push permissions are authorized (default: ","type":"text"},{"code":"true","type":"codeVoice"},{"text":").","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@objc"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"optInWhenPushAuthorized"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" "},{"kind":"keyword","text":"set"},{"kind":"text","text":" }"}],"platforms":["iOS"]}]},{"content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"text":"When enabled, the user’s state will change to ","type":"text"},{"code":"optedIn","type":"codeVoice"},{"text":" after accepting the push permissions prompt","type":"text"},{"text":" ","type":"text"},{"text":"or when manually switching from denied to authorized in the device settings. Under this condition,","type":"text"},{"text":" ","type":"text"},{"text":"the notification subscription state can be manually overridden by calling ","type":"text"},{"code":"set(pushNotificationSubscriptionState:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"but will be changed back to ","type":"text"},{"code":"optedIn","type":"codeVoice"},{"type":"text","text":" if either of the above scenarios occur."}],"type":"paragraph"},{"name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"When disabled, the user’s notification subscription state may still be opted in by the Braze backend."},{"type":"text","text":" "},{"type":"text","text":"This setting only affects whether the