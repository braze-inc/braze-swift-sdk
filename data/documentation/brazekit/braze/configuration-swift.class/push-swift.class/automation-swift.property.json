{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@objc"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"automation"},{"kind":"text","text":": "},{"identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/Configuration-swift.class\/Push-swift.class\/Automation-swift.class","kind":"typeIdentifier","preciseIdentifier":"s:8BrazeKit0A0C13ConfigurationC4PushC10AutomationC","text":"Automation"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" "},{"kind":"keyword","text":"set"},{"text":" }","kind":"text"}],"platforms":["iOS"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"name":"Important","style":"important","content":[{"type":"paragraph","inlineContent":[{"text":"The SDK must be initialized on the main thread to enable push notification","type":"text"},{"text":" ","type":"text"},{"text":"automation. SDK initialization must happen before the application has finished launching","type":"text"},{"text":" ","type":"text"},{"text":"or in your AppDelegate ","type":"text"},{"identifier":"https:\/\/archive.is\/nUG1k","type":"reference","isActive":true},{"text":" implementation.","type":"text"},{"text":" ","type":"text"},{"text":"If the application setup requires the SDK to be initialized after the application has","type":"text"},{"text":" ","type":"text"},{"text":"finished launching, refer to the","type":"text"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/prepareForDelayedInitialization(pushAutomation:analyticsBehavior:)"},{"type":"text","text":" method."}]}],"type":"aside"},{"name":"Note","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"The automation steps performed by the SDK are compatible with pre-existing push","type":"text"},{"text":" ","type":"text"},{"text":"notification handling integrations in your codebase. The SDK only automates the","type":"text"},{"text":" ","type":"text"},{"text":"processing of remote notification received from Braze. Any system handler implemented","type":"text"},{"text":" ","type":"text"},{"text":"to process your own or another third party SDK remote notifications will continue to","type":"text"},{"text":" ","type":"text"},{"text":"work when ","type":"text"},{"code":"automation","type":"codeVoice"},{"text":" is enabled.","type":"text"}]}],"type":"aside"},{"inlineContent":[{"text":"By default, the SDK does not perform any automation steps and you are required to implement","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"code":"UIApplicationDelegate","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"UNUserNotificationCenterDelegate","type":"codeVoice"},{"text":" methods yourself as","type":"text"},{"text":" ","type":"text"},{"text":"described in the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Braze\/tutorials\/Braze\/b1-standard-push-notifications","type":"reference"},{"text":" tutorial.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You can enable automatic push notification handling as follows:"}],"type":"paragraph"},{"code":["configuration.push.automation = true"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"type":"text","text":"This instructs the SDK to:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Register your application for push notification on the system."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Request the push notification authorization \/ permission at initialization."}]}]},{"content":[{"inlineContent":[{"text":"Dynamically provide implementations for the push notification related system delegate","type":"text"},{"text":" ","type":"text"},{"text":"methods.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"For a more granular behavior, each automation step can be enabled individually:"}],"type":"paragraph"},{"code":["\/\/ Automate only the `application(_:didRegisterForRemoteNotificationsWithDeviceToken:)`","\/\/ delegate method","configuration.push.automation.registerDeviceToken = true"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Or you can perform a combination of both approaches:"}],"type":"paragraph"},{"code":["\/\/ Enable all automations","configuration.push.automation = true","\/\/ Disable the automatic notification authorization request at launch.","configuration.push.automation.requestAuthorizationAtLaunch = false"],"syntax":null,"type":"codeListing"},{"name":"Important","style":"important","content":[{"type":"paragraph","inlineContent":[{"text":"When enabled, the ","type":"text"},{"code":"UIApplicationDelegate","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"UNUserNotificationCenterDelegate","type":"codeVoice"},{"text":" methods will not be executed when processing remote","type":"text"},{"text":" ","type":"text"},{"text":"notifications received from Braze.","type":"text"},{"text":" ","type":"text"},{"text":"Use ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/Notifications-swift.class\/subscribeToUpdates(payloadTypes:_:)"},{"text":" to subscribe to","type":"text"},{"text":" ","type":"text"},{"text":"those push notification updates when ","type":"text"},{"code":"automation","type":"codeVoice"},{"text":" is enabled.","type":"text"}]}],"type":"aside"},{"inlineContent":[{"text":"The behavior of each automation step is described in","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/Configuration-swift.class\/Push-swift.class\/Automation-swift.class","type":"reference","isActive":true},{"text