{"sections":[],"hierarchy":{"paths":[["doc:\/\/Braze\/documentation\/BrazeKit","doc:\/\/Braze\/documentation\/BrazeKit\/Braze","doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/Configuration-swift.class","doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/Configuration-swift.class\/Push-swift.class"]]},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/Configuration-swift.class\/Push-swift.class\/automation-swift.property"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@objc","kind":"attribute"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"automation","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Automation","kind":"typeIdentifier","identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/Configuration-swift.class\/Push-swift.class\/Automation-swift.class","preciseIdentifier":"s:8BrazeKit0A0C13ConfigurationC4PushC10AutomationC"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" ","kind":"text"},{"text":"set","kind":"keyword"},{"text":" }","kind":"text"}],"languages":["swift"],"platforms":["iOS"]}]},{"content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK must be initialized on the main thread to enable push notification"},{"type":"text","text":" "},{"type":"text","text":"automation. SDK initialization must happen before the application has finished launching"},{"type":"text","text":" "},{"type":"text","text":"or in your AppDelegate "},{"type":"reference","isActive":true,"identifier":"https:\/\/archive.is\/nUG1k"},{"type":"text","text":" implementation."},{"type":"text","text":" "},{"type":"text","text":"If the application setup requires the SDK to be initialized after the application has"},{"type":"text","text":" "},{"type":"text","text":"finished launching, refer to the"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/prepareForDelayedInitialization(pushAutomation:analyticsBehavior:)"},{"type":"text","text":" method."}]}],"type":"aside","name":"Important","style":"important"},{"content":[{"inlineContent":[{"text":"The automation steps performed by the SDK are compatible with pre-existing push","type":"text"},{"text":" ","type":"text"},{"text":"notification handling integrations in your codebase. The SDK only automates the","type":"text"},{"text":" ","type":"text"},{"text":"processing of remote notification received from Braze. Any system handler implemented","type":"text"},{"text":" ","type":"text"},{"text":"to process your own or another third party SDK remote notifications will continue to","type":"text"},{"text":" ","type":"text"},{"text":"work when ","type":"text"},{"code":"automation","type":"codeVoice"},{"text":" is enabled.","type":"text"}],"type":"paragraph"}],"type":"aside","name":"Note","style":"note"},{"inlineContent":[{"type":"text","text":"By default, the SDK does not perform any automation steps and you are required to implement"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"codeVoice","code":"UIApplicationDelegate"},{"type":"text","text":" and "},{"type":"codeVoice","code":"UNUserNotificationCenterDelegate"},{"type":"text","text":" methods yourself as"},{"type":"text","text":" "},{"type":"text","text":"described in the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Braze\/tutorials\/Braze\/b1-standard-push-notifications"},{"type":"text","text":" tutorial."}],"type":"paragraph"},{"inlineContent":[{"text":"You can enable automatic push notification handling as follows:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":null,"code":["configuration.push.automation = true"]},{"inlineContent":[{"type":"text","text":"This instructs the SDK to:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Register your application for push notification on the system."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Request the push notification authorization \/ permission at initialization."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Dynamically provide implementations for the push notification related system delegate"},{"type":"text","text":" "},{"type":"text","text":"methods."}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"For a more granular behavior, each automation step can be enabled individually:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":null,"code":["\/\/ Automate only the `application(_:didRegisterForRemoteNotificationsWithDeviceToken:)`","\/\/ delegate method","configuration.push.automation.registerDeviceToken = true"]},{"inlineContent":[{"text":"Or you can perform a combination of both approaches:","type":"text"}],"type":"paragraph"},{"code":["\/\/ Enable all automations","configuration.push.automation = true","\/\/ Disable the automatic notification authorization request at launch.","configuration.push.automation.requestAuthorizationAtLaunch = false"],"type":"codeListing","syntax":null},{"style":"important","type":"aside","name":"Important","content":[{"inlineContent":[{"type":"text","text":"When enabled, the "},{"type":"codeVoice","code":"UIApplicationDelegate"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"UNUserNotificationCenterDelegate"},{"type":"text","text":" methods will not be executed when processing remote"},{"type":"text","text":" "},{"type":"text","text":"notifications received from Braze."},{"type":"text","text":" "},{"type":"text","text":"Use "},{"identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/Notifications-swift.class\/subscribeToUpdates(payloadTypes:_:)","type":"reference","isActive":true},{"type":"text","text":" to subscribe to"},{"type":"text","text":" "},{"type":"text","text":"those push notification updates when "},{"type":"codeVoice","code":"automation"},{"type":"text","text":" is enabled."}],"type":"paragraph"}]},{"inlineContent":[{"type":"text","text":"The behavior of each automation step is described in"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/Configuration-swift.class\/Push-swift.class\/Automation-swift.class","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"type":"text","text":"The automatic push notification handling behavior (default: disabled)."}],"variants":[{"paths":["\/documentation\/brazekit\/braze\/configuration-swift.class\/push-swift.class\/automation-swift.property"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"externalID":"s:8BrazeKit0A0C13ConfigurationC4PushC10automationAG10AutomationCvp","symbolKind":"property","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"automation","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Automation","kind":"typeIdentifier","preciseIdentifier":"s:8BrazeKit0A0C13ConfigurationC4PushC10AutomationC"}],"roleHeading":"Instance Property","title":"automation","modules":[{"name":"BrazeKit"}],"role":"symbol"},"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"https://archive.is/nUG1k":{"identifier":"https:\/\/archive.is\/nUG1k","type":"link","titleInlineContent":[{"type":"codeVoice","code":"application(_:didFinishLaunchingWithOptions:)"}],"title":"application(_:didFinishLaunchingWithOptions:)","url":"https:\/\/archive.is\/nUG1k"},"doc://Braze/tutorials/Braze/b1-standard-push-notifications":{"estimatedTime":"20min","abstract":[{"text":"Learn how to support receiving foreground and background push notifications.","type":"text"}],"kind":"project","identifier":"doc:\/\/Braze\/tutorials\/Braze\/b1-standard-push-notifications","type":"topic","role":"project","title":"Standard Push Notifications","