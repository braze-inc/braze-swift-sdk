{"kind":"symbol","abstract":[{"type":"text","text":"The automatic push notification handling behavior (default: disabled)."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/brazekit\/braze\/configuration-swift.class\/push-swift.class\/automation-swift.property"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS"],"tokens":[{"kind":"attribute","text":"@objc"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"automation"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Automation","preciseIdentifier":"s:8BrazeKit0A0C13ConfigurationC4PushC10AutomationC","identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/Configuration-swift.class\/Push-swift.class\/Automation-swift.class"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" "},{"kind":"keyword","text":"set"},{"kind":"text","text":" }"}],"languages":["swift"]}]},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"style":"important","type":"aside","content":[{"inlineContent":[{"type":"text","text":"The SDK must be initialized on the main thread to enable push notification"},{"type":"text","text":" "},{"type":"text","text":"automation. SDK initialization must happen before the application has finished launching"},{"type":"text","text":" "},{"type":"text","text":"or in your AppDelegate "},{"type":"reference","identifier":"https:\/\/archive.is\/nUG1k","isActive":true},{"type":"text","text":" implementation."},{"type":"text","text":" "},{"type":"text","text":"If the application setup requires the SDK to be initialized after the application has"},{"type":"text","text":" "},{"type":"text","text":"finished launching, refer to the"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/prepareForDelayedInitialization(pushAutomation:analyticsBehavior:)","isActive":true},{"type":"text","text":" method."}],"type":"paragraph"}],"name":"Important"},{"style":"note","type":"aside","content":[{"inlineContent":[{"text":"The automation steps performed by the SDK are compatible with pre-existing push","type":"text"},{"text":" ","type":"text"},{"text":"notification handling integrations in your codebase. The SDK only automates the","type":"text"},{"text":" ","type":"text"},{"text":"processing of remote notification received from Braze. Any system handler implemented","type":"text"},{"text":" ","type":"text"},{"text":"to process your own or another third party SDK remote notifications will continue to","type":"text"},{"text":" ","type":"text"},{"text":"work when ","type":"text"},{"code":"automation","type":"codeVoice"},{"text":" is enabled.","type":"text"}],"type":"paragraph"}],"name":"Note"},{"type":"paragraph","inlineContent":[{"type":"text","text":"By default, the SDK does not perform any automation steps and you are required to implement"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"codeVoice","code":"UIApplicationDelegate"},{"type":"text","text":" and "},{"type":"codeVoice","code":"UNUserNotificationCenterDelegate"},{"type":"text","text":" methods yourself as"},{"type":"text","text":" "},{"type":"text","text":"described in the "},{"identifier":"doc:\/\/Braze\/tutorials\/Braze\/b1-standard-push-notifications","type":"reference","isActive":true},{"type":"text","text":" tutorial."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can enable automatic push notification handling as follows:"}]},{"type":"codeListing","syntax":null,"code":["configuration.push.automation = true"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This instructs the SDK to:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Register your application for push notification on the system."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Request the push notification authorization \/ permission at initialization.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Dynamically provide implementations for the push notification related system delegate","type":"text"},{"text":" ","type":"text"},{"text":"methods.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For a more granular behavior, each automation step can be enabled individually:"}]},{"type":"codeListing","syntax":null,"code":["\/\/ Automate only the `application(_:didRegisterForRemoteNotificationsWithDeviceToken:)`","\/\/ delegate method","configuration.push.automation.registerDeviceToken = true"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Or you can perform a combination of both approaches:"}]},{"code":["\/\/ Enable all automations","configuration.push.automation = true","\/\/ Disable the automatic notification authorization request at launch.","configuration.push.automation.requestAuthorizationAtLaunch = false"],"type":"codeListing","syntax":null},{"style":"important","name":"Important","type":"aside","content":[{"inlineContent":[{"type":"text","text":"When enabled, the "},{"type":"codeVoice","code":"UIApplicationDelegate"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"UNUserNotificationCenterDelegate"},{"type":"text","text":" methods will not be executed when processing remote"},{"type":"text","text":" "},{"type":"text","text":"notifications received from Braze."},{"type":"text","text":" "},{"type":"text","text":"Use "},{"identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/Notifications-swift.class\/subscribeToUpdates(payloadTypes:_:)","type":"reference","isActive":true},{"type":"text","text":" to subscribe to"},{"type":"text","text":" "},{"type":"text","text":"those push notification updates when "},{"type":"codeVoice","code":"automation"},{"type":"text","text":" is enabled."}],"type":"paragraph"}]},{"inlineContent":[{"text":"The behavior of each automation step is described in","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/Configuration-swift.class\/Push-swift.class\/Automation-swift.class","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"sections":[],"identifier":{"url":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/Configuration-swift.class\/Push-swift.class\/automation-swift.property","interfaceLanguage":"swift"},"metadata":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"automation","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:8BrazeKit0A0C13ConfigurationC4PushC10AutomationC","text":"Automation","kind":"typeIdentifier"}],"symbolKind":"property","roleHeading":"Instance Property","modules":[{"name":"BrazeKit"}],"role":"symbol","externalID":"s:8BrazeKit0A0C13ConfigurationC4PushC10automationAG10AutomationCvp","title":"automation"},"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/Braze\/documentation\/BrazeKit","doc:\/\/Braze\/documentation\/BrazeKit\/Braze","doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/Configuration-swift.class","doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/Configuration-swift.class\/Push-swift.class"]]},"references":{"doc://Braze/documentation/BrazeKit":{"identifier":"doc:\/\/Braze\/documentation\/BrazeKit","type":"topic","title":"BrazeKit","url":"\/documentation\/brazekit","kind":"symbol","role":"collection","abstract":[{"type":"text","text":"The main Braze framework providing user sessions, attributes and events logging, push notification support."}]},"doc://Braze/documentation/BrazeKit/Braze/Configuration-swift.class/Push-swift.class/Automation-swift.class":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Automation","kind":"identifier"}],"identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/Configuration-