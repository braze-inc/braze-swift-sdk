k","type":"reference","isActive":true},{"text":" implementation.","type":"text"},{"text":" ","type":"text"},{"text":"If the application setup requires the SDK to be initialized after the application has","type":"text"},{"text":" ","type":"text"},{"text":"finished launching, refer to the","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/prepareForDelayedInitialization(pushAutomation:analyticsBehavior:)","isActive":true,"type":"reference"},{"text":" method.","type":"text"}]}],"style":"important","name":"Important","type":"aside"},{"content":[{"inlineContent":[{"type":"text","text":"The automation steps performed by the SDK are compatible with pre-existing push"},{"type":"text","text":" "},{"type":"text","text":"notification handling integrations in your codebase. The SDK only automates the"},{"type":"text","text":" "},{"type":"text","text":"processing of remote notification received from Braze. Any system handler implemented"},{"type":"text","text":" "},{"type":"text","text":"to process your own or another third party SDK remote notifications will continue to"},{"type":"text","text":" "},{"type":"text","text":"work when "},{"code":"automation","type":"codeVoice"},{"type":"text","text":" is enabled."}],"type":"paragraph"}],"style":"note","name":"Note","type":"aside"},{"type":"paragraph","inlineContent":[{"type":"text","text":"By default, the SDK does not perform any automation steps and you are required to implement"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"codeVoice","code":"UIApplicationDelegate"},{"type":"text","text":" and "},{"type":"codeVoice","code":"UNUserNotificationCenterDelegate"},{"type":"text","text":" methods yourself as"},{"type":"text","text":" "},{"type":"text","text":"described in the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Braze\/tutorials\/Braze\/b1-standard-push-notifications"},{"type":"text","text":" tutorial."}]},{"type":"paragraph","inlineConten