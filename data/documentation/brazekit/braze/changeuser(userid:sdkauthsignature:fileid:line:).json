{"abstract":[{"type":"text","text":"Change the current identified Braze user."}],"hierarchy":{"paths":[["doc:\/\/Braze\/documentation\/BrazeKit","doc:\/\/Braze\/documentation\/BrazeKit\/Braze"]]},"kind":"symbol","sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/changeUser(userId:sdkAuthSignature:fileID:line:)"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/brazekit\/braze\/changeuser(userid:sdkauthsignature:fileid:line:)"]}],"metadata":{"roleHeading":"Instance Method","externalID":"s:8BrazeKit0A0C10changeUser6userId16sdkAuthSignature6fileID4lineySS_SSSgs12StaticStringVSutF","symbolKind":"method","modules":[{"name":"BrazeKit"}],"role":"symbol","title":"changeUser(userId:sdkAuthSignature:fileID:line:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"changeUser"},{"kind":"text","text":"("},{"kind":"externalParam","text":"userId"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"sdkAuthSignature"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"fileID"},{"kind":"text","text":": "},{"preciseIdentifier":"s:s12StaticStringV","kind":"typeIdentifier","text":"StaticString"},{"kind":"text","text":", "},{"kind":"externalParam","text":"line"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Su","kind":"typeIdentifier","text":"UInt"},{"kind":"text","text":")"}],"extendedModule":"BrazeKit"},"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"changeUser"},{"kind":"text","text":"("},{"kind":"externalParam","text":"userId"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"sdkAuthSignature"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"fileID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:s12StaticStringV","text":"StaticString"},{"kind":"text","text":" = "},{"kind":"keyword","text":"#fileID"},{"kind":"text","text":", "},{"kind":"externalParam","text":"line"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Su","text":"UInt"},{"text":" = ","kind":"text"},{"text":"#line","kind":"keyword"},{"text":")","kind":"text"}],"languages":["swift"],"platforms":["iOS"]}]},{"kind":"parameters","parameters":[{"name":"userId","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The new user identifier."}]}]},{"name":"sdkAuthSignature","content":[{"inlineContent":[{"text":"The optional user SDK authentication signature.","type":"text"}],"type":"paragraph"}]}]},{"content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When a user first uses Braze on a device, they are considered “anonymous”. Use this method to"},{"type":"text","text":" "},{"type":"text","text":"identify a user with a unique ID, which enables the following:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"If the same user is identified on another device, their user profile, usage history and event history","type":"text"},{"text":" ","type":"text"},{"text":"will be shared across devices.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"If your app is used on the same device by multiple people, you can assign each of them a unique","type":"text"},{"text":" ","type":"text"},{"text":"identifier to track them separately. Only the most recent user on a particular device will receive","type":"text"},{"text":" ","type":"text"},{"text":"push notifications and in-app messages.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When you request a user switch (which is any call to "},{"code":"changeUser","type":"codeVoice"},{"type":"text","text":" where the new user ID is not the same"},{"type":"text","text":" "},{"type":"text","text":"as the existing user ID), the current session for the previous user (anonymous or not) is automatically"},{"type":"text","text":" "},{"type":"text","text":"ended and a new session is started. Similarly, following a call to "},{"code":"changeUser","type":"codeVoice"},{"type":"text","text":", any events which fire are"},{"type":"text","text":" "},{"type":"text","text":"guaranteed to be for the new user. If an in-flight server request completes for the old user after the"},{"type":"text","text":" "},{"type":"text","text":"user switch, no events will fire, so you do not need to worry about filtering out events from Braze for old users."}]},{"type":"paragraph","inlineContent":[{"text":"Additionally, if you identify a user which has never been identified on another device, the entire history of that","type":"text"},{"text":" ","type":"text"},{"text":"user as an “anonymous” user on this device will be preserved and associated with the newly identified user.","type":"text"},{"text":" ","type":"text"},{"text":"However, if you identify a user which has been identified in another device, any history which was already","type":"text"},{"text":" ","type":"text"},{"text":"flushed to the server for the anonymous user on this device will be merged into the identified user.","type":"text"},{"text":" ","type":"text"},{"text":"(See: ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/www.braze.com\/docs\/api\/endpoints\/user_data\/post_users_merge#merge_updates-behavior"},{"type":"text","text":")"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note: Once you identify a user, you cannot revert to the “anonymous” user. The transition from anonymous"},{"type":"text","text":" "},{"type":"text","text":"to identified tracking is only allowed "},{"inlineContent":[{"type":"text","text":"once"}],"type":"emphasis"},{"type":"text","text":" because the initial anonymous user receives special treatment to"},{"type":"text","text":" "},{"type":"text","text":"allow for preservation of their history. As a result, we recommend against changing the user ID just because"},{"type":"text","text":" "},{"type":"text","text":"your app has entered a “logged out” state because it makes you unable to target the previously logged out"},{"type":"text","text":" "},{"type":"text","text":"user with re-engagement campaigns. If you anticipate multiple users on the same device, but only want to"},{"type":"text","text":" "},{"type":"text","text":"target one of them when your app is in a logged out state, we recommend separately keeping track of the"},{"type":"text","text":" "},{"type":"text","text":"user ID you want to target while logged out and switching back to that user ID as part of your app’s logout process."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note that the current user’s information and ID can be retrieved at any time via the "},{"isActive":true,"identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/user-swift.property","type":"reference"},{"type":"text","text":" module."}]}],"kind":"content"}],"seeAlsoSections":[{"identifiers":["doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/User-swift.class","doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/user-swift.property"],"anchor":"User","generated":true,"title":"User"}],"references":{"doc://Braze/documentation/BrazeKit":{"title":"BrazeKit","abstract":[{"type":"text","text":"The main Braze framework providing user sessions, attributes and events logging, push notification support."}],"kind":"symbol","role":"collection","type":"topic","url":"\/documentation\/brazekit","identifier":"doc:\/\/Braze\/documentation\/BrazeKit"},"doc://Braze/documentation/BrazeKit/Braze/user-swift.property":{"identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/user-swift.property","abstract":[{"text":"User module.","type":"text"}],"kind":"symbol","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"user","kind":"identifier"},{"text":": ","kind":"text"},{"text":"User","kind":"typeIdentifier","preciseIdentifier":"s:8BrazeKit0A0C4UserC"}],"url":"\/documentation\/brazekit\/braze\/user-swift.property","type":"topic","title":"user"},"doc://Braze/documentation/BrazeKit/Braze/changeUser(userId:sdkAuthSignature:fileID:line:)":{"role":"symbol","url":"\/documentation\/brazekit\/braze\/changeuser(userid:sdkauthsignature:fileid:line:)","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Change the current identified Braze user."}],"identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/changeUser(userId:sdkAuthSignature:fileID:line:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"changeUser"},{"kind":"text","text":"("},{"kind":"externalParam","text":"userId"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"sdkAuthSignature"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"fileID"},{"kind":"text","text":": "},{"preciseIdentifier":"s:s12StaticStringV","kind":"typeIdentifier","text":"StaticString"},{"kind":"text","text":", "},{"kind":"externalParam","text":"line"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Su","kind":"typeIdentifier","text":"UInt"},{"kind":"text","text":")"}],"title":"changeUser(userId:sdkAuthSignature:fileID:line:)"},"doc://Braze/documentation/BrazeKit/Braze/User-swift.class":{"identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/User-swift.class","title":"Braze.User","type":"topic","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"User","kind":"identifier"}],"navigatorTitle":[{"text":"User","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"The user module allows setting attributes on the current user.","type":"text"}],"url":"\/documentation\/brazekit\/braze\/user-swift.class"},"https://www.braze.com/docs/api/endpoints/user_data/post_users_merge#merge_updates-behavior":{"title":"List of merge fields","titleInlineContent":[{"text":"List of merge fields","type":"text"}],"type":"link","url":"https:\/\/www.braze.com\/docs\/api\/endpoints\/user_data\/post_users_merge#merge_updates-behavior","identifier":"https:\/\/www.braze.com\/docs\/api\/endpoints\/user_data\/post_users_merge#merge_updates-behavior"},"doc://Braze/documentation/BrazeKit/Braze":{"title":"Braze","identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze","role":"symbol","kind":"symbol","abstract":[{"identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze","type":"reference","isActive":true},{"type":"text","text":" is the main entry point of the BrazeKit module and provides access to all its features."}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Braze","kind":"identifier"}],"type":"topic","url":"\/documentation\/brazekit\/braze","navigatorTitle":[{"text":"Braze","kind":"identifier"}]}}}