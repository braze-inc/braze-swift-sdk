{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/WebViewBridge\/ScriptMessageHandler\/callAsyncJavaScript(_:arguments:in:completionHandler:)"},"hierarchy":{"paths":[["doc:\/\/Braze\/documentation\/BrazeKit","doc:\/\/Braze\/documentation\/BrazeKit\/Braze","doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/WebViewBridge","doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/WebViewBridge\/ScriptMessageHandler"]]},"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","text":"MainActor","preciseIdentifier":"s:ScM"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"callAsyncJavaScript"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"functionBody"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"arguments"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":" : "},{"kind":"keyword","text":"Any"},{"kind":"text","text":"] = [:], "},{"kind":"externalParam","text":"in"},{"kind":"text","text":" "},{"kind":"internalParam","text":"webView"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"WKWebView","preciseIdentifier":"c:objc(cs)WKWebView"},{"kind":"text","text":", "},{"kind":"externalParam","text":"completionHandler"},{"kind":"text","text":": (@"},{"kind":"typeIdentifier","text":"MainActor","preciseIdentifier":"s:ScM"},{"kind":"text","text":" ("},{"kind":"typeIdentifier","text":"Result","preciseIdentifier":"s:s6ResultO"},{"kind":"text","text":"<"},{"kind":"keyword","text":"Any"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Error","identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/WebViewBridge\/ScriptMessageHandler\/Error","preciseIdentifier":"s:8BrazeKit0A0C13WebViewBridgeO20ScriptMessageHandlerC5ErrorO"},{"kind":"text","text":">) -> "},{"kind":"typeIdentifier","text":"Void","preciseIdentifier":"s:s4Voida"},{"kind":"text","text":")? = nil)"}],"platforms":["iOS"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The JavaScript string to use as the function body. This method treats","type":"text"},{"text":" ","type":"text"},{"text":"the string as an anonymous JavaScript function body and calls it with","type":"text"},{"text":" ","type":"text"},{"text":"the named arguments in the ","type":"text"},{"code":"arguments","type":"codeVoice"},{"text":" parameter.","type":"text"}]}],"name":"functionBody"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A dictionary of the arguments to pass to the function call. Each key in the"},{"type":"text","text":" "},{"type":"text","text":"dictionary corresponds to the name of an argument in the functionBody"},{"type":"text","text":" "},{"type":"text","text":"string, and the value of that key is the value to use during the evaluation"},{"type":"text","text":" "},{"type":"text","text":"of the code. Supported value types are "},{"type":"codeVoice","code":"NSNumber"},{"type":"text","text":", "},{"type":"codeVoice","code":"NSString"},{"type":"text","text":", "},{"type":"codeVoice","code":"NSArray"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"NSDictionary"},{"type":"text","text":", or "},{"type":"codeVoice","code":"NSNull"},{"type":"text","text":". All items in an array or dictionary must also"},{"type":"text","text":" "},{"type":"text","text":"be one of the supported types."}]}],"name":"arguments"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The web view in which the JavaScript function is executed. The web view must"},{"type":"text","text":" "},{"type":"text","text":"implement the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/WebViewBridge\/ScriptMessageHandler"},{"type":"text","text":"."}]}],"name":"webView"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A handler block to execute when script evaluation finishes. The"},{"type":"text","text":" "},{"type":"text","text":"method calls your block whether script evaluation completes"},{"type":"text","text":" "},{"type":"text","text":"successfully or fails. The block has no return value and takes the"},{"type":"text","text":" "},{"type":"text","text":"following parameter:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"result: The result of the script evaluation, or an error object that contains","type":"text"},{"type":"text","text":" "},{"type":"text","text":"information about the problem that occurred. If your function body doesn’t"},{"type":"text","text":" "},{"type":"text","text":"return an explicit value, WebKit passes "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" to your completion handler on"},{"type":"text","text":" "},{"type":"text","text":"success. If your function explicitly returns null, WebKit returns that value"},{"type":"text","text":" "},{"type":"text","text":"as an "},{"type":"codeVoice","code":"NSNull"},{"type":"text","text":" object."}],"type":"paragraph"}]}]}],"name":"completionHandler"}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"content":[{"inlineContent":[{"text":"This function is a backport of the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"WKWebView.callAsyncJavaScript(_:arguments:in:completionHandler:)"},{"text":" method. It relies on","type":"text"},{"text":" ","type":"text"},{"text":"the script message handler to pass the result or error to the native side","type":"text"},{"text":" ","type":"text"},{"text":"asynchronously.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It differs from the WebKit method in the following ways:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"No support for passing ","type":"text"},{"code":"NSDate","type":"codeVoice"},{"text":" as an argument.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Errors are not wrapped in a "},{"type":"codeVoice","code":"WKError"},{"type":"text","text":" object."}]}]}]}],"style":"note","type":"aside","name":"Note"},{"inlineContent":[{"type":"text","text":"Don’t format the string in the "},{"code":"functionBody","type":"codeVoice"},{"type":"text","text":" parameter as a function-like callable"},{"type":"text","text":" "},{"type":"text","text":"object, as you would in pure JavaScript. Instead, put only the body of the function in the"},{"type":"text","text":" "},{"type":"text","text":"string. For example, the following string shows a valid function body that takes x, y, and"},{"type":"text","text":" "},{"type":"text","text":"z arguments and returns a result."}],"type":"paragraph"},{"code":["return x ? y : z"],"type":"codeListing","syntax":"js"},{"inlineContent":[{"type":"text","text":"If your JavaScript code returns an object with a callable "},{"type":"codeVoice","code":"then"},{"type":"text","text":" property, the function"},{"type":"text","text":" "},{"type":"text","text":"calls that property on the resulting object and waits for its resolution. If resolution"},{"type":"text","text":" "},{"type":"text","text":"succeeds, the function passes the resulting object to your completion handler. If"},{"type":"text","text":" "},{"type":"text","text":"resolution fails, the function returns an error to your completion handler."}],"type":"paragraph"},{"inlineContent":[{"text":"Because this method calls your JavaScript code asynchronously, you can call ","type":"text"},{"type":"codeVoice","code":"await"},{"text":" on","type":"text"},{"text":" ","type":"text"},{"text":"objects with a then property inside your function body. The following code example","type":"text"},{"text":" ","type":"text"},{"text":"illustrates this technique.","type":"text"}],"type":"paragraph"},{"code":["var p = new Promise(function (f) {","  window.setTimeout(\"f(42)\", 1000);","});","await p;","return p;"],"type":"codeListing","syntax":"js"}]}],"abstract":[{"type":"text","text":"Executes the specified string as an asynchronous JavaScript function."}],"variants":[{"paths":["\/documentation\/brazekit\/braze\/webviewbridge\/scriptmessagehandler\/callasyncjavascript(_:arguments:in:completionhandler:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","metadata":{"role":"symbol","roleHeading":"Instance Method","externalID":"s:8BrazeKit0A0C13WebViewBridgeO20ScriptMessageHandlerC013callAsyncJavaF0_9arguments2in010completionH0ySS_SDySSypGSo05WKWebD0Cys6ResultOyypAG5ErrorOGcSgtF","symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"callAsyncJavaScript"},{"kind":"text","text":"("},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"arguments"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":" : "},{"kind":"keyword","text":"Any"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"in"},{"kind":"text","text":": "},{"preciseIdentifier":"c:objc(cs)WKWebView","kind":"typeIdentifier","text":"WKWebView"},{"kind":"text","text":", "},{"kind":"externalParam","text":"completionHandler"},{"kind":"text","text":": (@"},{"preciseIdentifier":"s:ScM","kind":"typeIdentifier","text":"MainActor"},{"kind":"text","text":" ("},{"preciseIdentifier":"s:s6ResultO","kind":"typeIdentifier","text":"Result"},{"kind":"text","text":"<"},{"kind":"keyword","text":"Any"},{"kind":"text","text":",