{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","preciseIdentifier":"s:ScM","kind":"attribute"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"callAsyncJavaScript","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"functionBody","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"arguments","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Any","kind":"keyword"},{"text":"] = [:], ","kind":"text"},{"text":"in","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"webView","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"WKWebView","preciseIdentifier":"c:objc(cs)WKWebView","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"completionHandler","kind":"externalParam"},{"text":": (@","kind":"text"},{"text":"MainActor","preciseIdentifier":"s:ScM","kind":"typeIdentifier"},{"text":" (","kind":"text"},{"text":"Result","preciseIdentifier":"s:s6ResultO","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Any","kind":"keyword"},{"text":", ","kind":"text"},{"text":"Error","identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/WebViewBridge\/ScriptMessageHandler\/Error","preciseIdentifier":"s:8BrazeKit0A0C13WebViewBridgeO20ScriptMessageHandlerC5ErrorO","kind":"typeIdentifier"},{"text":">) -> ","kind":"text"},{"text":"Void","preciseIdentifier":"s:s4Voida","kind":"typeIdentifier"},{"text":")? = nil)","kind":"text"}],"languages":["swift"],"platforms":["iOS"]}]},{"parameters":[{"name":"functionBody","content":[{"inlineContent":[{"text":"The JavaScript string to use as the function body. This method treats","type":"text"},{"text":" ","type":"text"},{"text":"the string as an anonymous JavaScript function body and calls it with","type":"text"},{"text":" ","type":"text"},{"text":"the named arguments in the ","type":"text"},{"code":"arguments","type":"codeVoice"},{"text":" parameter.","type":"text"}],"type":"paragraph"}]},{"name":"arguments","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A dictionary of the arguments to pass to the function call. Each key in the"},{"type":"text","text":" "},{"type":"text","text":"dictionary corresponds to the name of an argument in the functionBody"},{"type":"text","text":" "},{"type":"text","text":"string, and the value of that key is the value to use during the evaluation"},{"type":"text","text":" "},{"type":"text","text":"of the code. Supported value types are "},{"type":"codeVoice","code":"NSNumber"},{"type":"text","text":", "},{"type":"codeVoice","code":"NSString"},{"type":"text","text":", "},{"type":"codeVoice","code":"NSArray"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"NSDictionary"},{"type":"text","text":", or "},{"type":"codeVoice","code":"NSNull"},{"type":"text","text":". All items in an array or dictionary must also"},{"type":"text","text":" "},{"type":"text","text":"be one of the supported types."}]}]},{"name":"webView","content":[{"inlineContent":[{"type":"text","text":"The web view in which the JavaScript function is executed. The web view must"},{"type":"text","text":" "},{"type":"text","text":"implement the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/WebViewBridge\/ScriptMessageHandler"},{"type":"text","text":"."}],"type":"paragraph"}]},{"name":"completionHandler","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A handler block to execute when script evaluation finishes. The"},{"type":"text","text":" "},{"type":"text","text":"method calls your block whether script evaluation completes"},{"type":"text","text":" "},{"type":"text","text":"successfully or fails. The block has no return value and takes the"},{"type":"text","text":" "},{"type":"text","text":"following parameter:"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"result: The result of the script evaluation, or an error object that contains"},{"type":"text","text":" "},{"type":"text","text":"information about the problem that occurred. If your function body doesn’t"},{"type":"text","text":" "},{"type":"text","text":"return an explicit value, WebKit passes "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" to your completion handler on"},{"type":"text","text":" "},{"type":"text","text":"success. If your function explicitly returns null, WebKit returns that value"},{"type":"text","text":" "},{"type":"text","text":"as an "},{"code":"NSNull","type":"codeVoice"},{"type":"text","text":" object."}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"kind":"parameters"},{"kind":"content","content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"aside","style":"note","name":"Note","content":[{"inlineContent":[{"type":"text","text":"This function is a backport of the"},{"type":"text","text":" "},{"code":"WKWebView.callAsyncJavaScript(_:arguments:in:completionHandler:)","type":"codeVoice"},{"type":"text","text":" method. It relies on"},{"type":"text","text":" "},{"type":"text","text":"the script message handler to pass the result or error to the native side"},{"type":"text","text":" "},{"type":"text","text":"asynchronously."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It differs from the WebKit method in the following ways:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"No support for passing "},{"code":"NSDate","type":"codeVoice"},{"type":"text","text":" as an argument."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Errors are not wrapped in a ","type":"text"},{"type":"codeVoice","code":"WKError"},{"text":" object.","type":"text"}]}]}],"type":"unorderedList"}]},{"type":"paragraph","inlineContent":[{"text":"Don’t format the string in the ","type":"text"},{"code":"functionBody","type":"codeVoice"},{"text":" parameter as a function-like callable","type":"text"},{"text":" ","type":"text"},{"text":"object, as you would in pure JavaScript. Instead, put only the body of the function in the","type":"text"},{"text":" ","type":"text"},{"text":"string. For example, the following string shows a valid function body that takes x, y, and","type":"text"},{"text":" ","type":"text"},{"text":"z arguments and returns a result.","type":"text"}]},{"type":"codeListing","syntax":"js","code":["return x ? y : z"]},{"type":"paragraph","inlineContent":[{"text":"If your JavaScript code returns an object with a callable ","type":"text"},{"code":"then","type":"codeVoice"},{"text":" property, the function","type":"text"},{"text":" ","type":"text"},{"text":"calls that property on the resulting object and waits for its resolution. If resolution","type":"text"},{"text":" ","type":"text"},{"text":"succeeds, the function passes the resulting object to your completion handler. If","type":"text"},{"text":" ","type":"text"},{"text":"resolution fails, the function returns an error to your completion handler.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Because this method calls your JavaScript code asynchronously, you can call "},{"code":"await","type":"codeVoice"},{"type":"text","text":" on"},{"type":"text","text":" "},{"type":"text","text":"objects with a then property inside your function body. The following code example"},{"type":"text","text":" "},{"type":"text","text":"illustrates this technique."}]},{"type":"codeListing","syntax":"js","code":["var p = new Promise(function (f) {","  window.setTimeout(\"f(42)\", 1000);","});","await p;","return p;"]}]}],"metadata":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{