the specified string as an asynchronous JavaScript function."}],"variants":[{"paths":["\/documentation\/brazekit\/braze\/webviewbridge\/scriptmessagehandler\/callasyncjavascript(_:arguments:in:completionhandler:)"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"preciseIdentifier":"s:ScM","text":"MainActor","kind":"attribute"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"callAsyncJavaScript","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"functionBody","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"arguments","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":" : ","kind":"text"},{"kind":"keyword","text":"Any"},{"kind":"text","text":"] = [:], "},{"kind":"externalParam","text":"in"},{"kind":"text","text":" "},{"kind":"internalParam","text":"webView"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"WKWebView","preciseIdentifier":"c:objc(cs)WKWebView"},{"kind":"text","text":", "},{"kind":"externalParam","text":"completionHandler"},{"kind":"text","text":": (@"},{"kind":"typeIdentifier","text":"MainActor","preciseIdentifier":"s:ScM"},{"kind":"text","text":" ("},{"kind":"typeIdentifier","text":"Result","preciseIdentifier":"s:s6ResultO"},{"kind":"text","text":"<"},{"kind":"keyword","text":"Any"},{"kind":"text","text":", "},{"identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/WebViewBridge\/ScriptMessageHandler\/Error","kind":"typeIdentifier","text":"Error","preciseIdentifier":"s:8BrazeKit0A0C13WebViewBridgeO20ScriptMessageHandlerC5ErrorO"},{"kind":"text","text":">) -> "},{"kind":"typeIdentifier","text":"Void","preciseIdentifier":"s:s4Voida"},{"kind":"text","text":")? = nil)"}],"platforms":["iOS"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The JavaScript string to use as the function body. This method treats"},{"type":"text","text":" "},{"type":"text","text":"the string as an anonymous JavaScript function body and calls it with"},{"type":"text","text":" "},{"type":"text","text":"the named arguments in the "},{"code":"arguments","type":"codeVoice"},{"type":"text","text":" parameter."}]}],"name":"functionBody"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A dictionary of the arguments to pass to the function call. Each key in the"},{"type":"text","text":" "},{"type":"text","text":"dictionary corresponds to the name of an argument in the functionBody"},{"type":"text","text":" "},{"type":"text","text":"string, and the value of that key is the value to use during the evaluation"},{"type":"text","text":" "},{"type":"text","text":"of the code. Supported value types are "},{"code":"NSNumber","type":"codeVoice"},{"type":"text","text":", "},{"code":"NSString","type":"codeVoice"},{"type":"text","text":", "},{"code":"NSArray","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"NSDictionary","type":"codeVoice"},{"type":"text","text":", or "},{"code":"NSNull","type":"codeVoice"},{"type":"text","text":". All items in an array or dictionary must also"},{"type":"text","text":" "},{"type":"text","text":"be one of the supported types."}]}],"name":"arguments"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The web view in which the JavaScript function is executed. The web view must","type":"text"},{"text":" ","type":"text"},{"text":"implement the ","type":"text"},{"identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/WebViewBridge\/ScriptMessageHandler","isActive":true,"type":"reference"},{"text":".","type":"text"}]}],"name":"webView"},{"content":[{"inlineContent":[{"text":"A handler block to execute when script evaluation finishes. The","type":"text"},{"text":" ","type":"text"},{"text":"method calls your block whether script evaluation completes","type":"text"},{"text":" ","type":"text"},{"text":"successfully or fails. The block has no return value and takes the","type":"text"},{"text":" ","type":"text"},{"text":"following parameter:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"result: The result of the script evaluation, or an error object that contains"},{"type":"text","text":" "},{"type":"text","text":"information about the problem that occurred. If your function body doesn’t"},{"type":"text","text":" "},{"type":"text","text":"return an explicit value, WebKit passes "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" to your completion handler on"},{"type":"text","text":" "},{"type":"text","text":"success. If your function explicitly returns null, WebKit returns that value"},{"type":"text","text":" "},{"type":"text","text":"as an "},{"type":"codeVoice","code":"NSNull"},{"type":"text","text":" object."}]}]}],"type":"unorderedList"}],"name":"completionHandler"}],"kind":"parameters"},{"content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"name":"Note","type":"aside","style":"note","content":[{"inlineContent":[{"text":"This function is a backport of the","type":"text"},{"text":" ","type":"text"},{"code":"WKWebView.callAsyncJavaScript(_:arguments:in:completionHandler:)","type":"codeVoice"},{"text":" method. It relies on","type":"text"},{"text":" ","type":"text"},{"text":"the script message handler to pass the result or error to the native side","type":"text"},{"text":" ","type":"text"},{"text":"asynchronously.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It differs from the WebKit method in the following ways:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"No support for passing "},{"type":"codeVoice","code":"NSDate"},{"type":"text","text":" as an argument."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Errors are not wrapped in a "},{"type":"codeVoice","code":"WKError"},{"type":"text","text":" object."}]}]}],"type":"unorderedList"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Don’t format the string in the "},{"type":"codeVoice","code":"functionBody"},{"type":"text","text":" parameter as a function-like callable"},{"type":"text","text":" "},{"type":"text","text":"object, as you would in pure JavaScript. Instead, put only the body of the function in the"},{"type":"text","text":" "},{"type":"text","text":"string. For example, the following string shows a valid function body that takes x, y, and"},{"type":"text","text":" "},{"type":"text","text":"z arguments and returns a result."}]},{"code":["return x ? y : z"],"syntax":"js","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"If your JavaScript code returns an object with a callable ","type":"text"},{"type":"codeVoice","code":"then"},{"text":" property, the function","type":"text"},{"text":" ","type":"text"},{"text":"calls that property on the resulting object and waits for its resolution. If resolution","type":"text"},{"text":" ","type":"text"},{"text":"succeeds, the function passes the resulting object to your completion handler. If","type":"text"},{"text":" ","type":"text"},{"text":"resolution fails, the function returns an error to your completion handler.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Because this method calls your JavaScript code asynchronously, you can call ","type":"text"},{"type":"codeVoice","code":"await"},{"text":" on","type":"text"},{"text":" ","type":"text"},{"text":"objects with a then property inside your function body. The following code example","type":"text"},{"text":" ","type":"text"},{"text":"illustrates this technique.","type":"text"}]},{"code":["var p = new Promise(function (f) {","  window.setTimeout(\"f(42)\", 1000);","});","await p;","return p;"],"syntax":"js","type":"codeListing"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/WebViewBridge\/ScriptMessageHandler\/callAsyncJavaScript(_:arguments:in:completionHandler:)"},"references":{"doc://Braze/documentation/BrazeKit":{"identifier":"doc:\/\/Braze\/documentation\/BrazeKit","type":"topic","title":"BrazeKit","url":"\/documentation\/brazekit","kind":"symbol","role":"collection","abstract":[{"type":"text","text":"The main Braze framework providing user sessions, attributes and events logging, push notification support."}]},"doc://Braze/documentation/BrazeKit/Braze":{"navigatorTitle":[{"kind":"identifier","text":"Braze"}],"url":"\/documentation\/brazekit\/braze","title":"Braze","abstract":[{"identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze","type":"reference","isActive":true},{"text":" is the main entry point of the BrazeKit module and provides access to all its features.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Braze"}],"type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze"},"doc://Braze/documentation/BrazeKit/Braze/WebViewBridge":{"abstract":[],"identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/WebViewBridge","url":"\/documentation\/brazekit\/braze\/webviewbridge","title":"Braze.WebViewBridge","type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WebViewBridge","kind":"identifier"}],"navigatorTitle":[{"text":"WebViewBridge","kind":"identifier"}]},"doc://Braze/documentation/BrazeKit/Braze/WebViewBridge/ScriptMessageHandler/callAsyncJavaScript(_:arguments:in:completionHandler:)":{"identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/WebViewBridge\/Scri