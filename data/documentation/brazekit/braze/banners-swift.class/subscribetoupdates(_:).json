xt":" "},{"type":"text","text":"invoked once with the current banners as an initial replay snapshot. The replay is"},{"type":"text","text":" "},{"type":"text","text":"scheduled on the view-store queue and dispatched to main from there, so the handler"},{"type":"text","text":" "},{"type":"text","text":"is always invoked "},{"type":"emphasis","inlineContent":[{"type":"text","text":"after"}]},{"type":"text","text":" "},{"code":"subscribeToUpdates(_:)","type":"codeVoice"},{"type":"text","text":" returns — never inline on the"},{"type":"text","text":" "},{"type":"text","text":"calling thread. The replay is delivered at most once, and is suppressed if a"},{"type":"text","text":" "},{"type":"text","text":"delegate-driven update lands on the subscriber first."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/brazekit\/braze\/banners-swift.class\/subscribetoupdates(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Braze/documentation/BrazeKit/Braze/Banners-swift.class":{"role":"symbol","abstract":[{"text":"The Banners module exposes the Braze SDK Banner Cards related properties and methods.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"Banners"}],"type":"topic","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Banners"}],"title":"Braze.Banners","url":"\/documentation\/brazekit\/braze\/banners-swift.class","identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/Banners-swift.class","kind":"symbol"},"doc://Braze/documentation/BrazeKit/Braze/Banners-swift.class/subscribeToUpdates(_:)":{"type":"topic","role":"symbol","abstract":[{"text":"Subscribes to banners updates.","type":"text"}],"title":"subscribeToUpdates(_:)","kind":"symbol","identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/Banners-swift.class\/subscribeToUpdates(_:)","url":"\/documentation\/brazekit\/braze\/banners-swift.class\/subscribetoupdates(_:)","fragments":[{"text":"func","ki