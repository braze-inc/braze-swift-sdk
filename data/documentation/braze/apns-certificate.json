{"sections":[],"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Before you can send a push notification using Braze, you must provide your Push notification file or certificate from Apple. You may present either a ","type":"text"},{"code":".p8","type":"codeVoice"},{"text":" file (recommended) or a ","type":"text"},{"code":".p12","type":"codeVoice"},{"text":" certificate.","type":"text"}]},{"text":".p8 File (recommended)","type":"heading","level":3,"anchor":"p8-File-recommended"},{"type":"paragraph","inlineContent":[{"text":"As described on this ","type":"text"},{"identifier":"https:\/\/help.apple.com\/developer-account\/#\/devcdfbb56a3","type":"reference","isActive":true},{"text":":","type":"text"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"In your developer account, go to ","type":"text"},{"identifier":"https:\/\/developer.apple.com\/account\/ios\/certificate","type":"reference","isActive":true},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Under Keys, select All and click the Add button (+) in the upper-right corner."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Under Key Description, enter a unique name for the signing key.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Under Key Services, select the APNs checkbox, then click Continue. Click "},{"type":"emphasis","inlineContent":[{"text":"Confirm","type":"text"}]},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"text":"Note the Key ID. Click ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"Download"}]},{"text":" to generate and download the key now.","type":"text"}],"type":"paragraph"}]}]},{"style":"note","type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"When you download the key, it is saved as a text file with a .p8 file extension. Save the file in a secure place because the key is ","type":"text"},{"inlineContent":[{"type":"text","text":"not saved in your developer account and you won’t be able to download it again"}],"type":"strong"},{"text":".","type":"text"}]}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Navigate to the ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/dashboard-01.braze.com\/app_settings\/app_settings"},{"text":" page in the dashboard and upload the .p8 file.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"When prompted, also enter your app’s "},{"type":"reference","identifier":"https:\/\/developer.apple.com\/account\/ios\/identifier\/bundle\/","isActive":true},{"type":"text","text":", the "},{"type":"reference","identifier":"https:\/\/developer.apple.com\/account\/ios\/authkey","isActive":true},{"type":"text","text":" that you noted when generating the key, and your "},{"type":"reference","identifier":"https:\/\/developer.apple.com\/account\/#\/membership","isActive":true},{"type":"text","text":". Click "},{"type":"emphasis","inlineContent":[{"text":"Save","type":"text"}]},{"type":"text","text":"."}]}]}]},{"anchor":"p12-Certificate-legacy","type":"heading","level":3,"text":".p12 Certificate (legacy)"},{"inlineContent":[{"text":"Alternatively, you may utilize Apple’s older authentication scheme (","type":"text"},{"code":".p12","type":"codeVoice"},{"text":" SSL certificates). Unlike the ","type":"text"},{"code":".p8","type":"codeVoice"},{"text":" solution described above, these certificates automatically expire every year and will require you to regenerate and re-upload them. Braze will send you email reminders as the certificate approaches expiration to help your notifications continue uninterrupted, but because this is a manual process we recommend utilizing the above-described ","type":"text"},{"code":".p8","type":"codeVoice"},{"text":" authentication scheme instead. However, if you still wish to, you may configure and upload ","type":"text"},{"code":".p12","type":"codeVoice"},{"text":" certificates as described here:","type":"text"}],"type":"paragraph"},{"text":"Step 1: Generate Certificate Signing Request","anchor":"Step-1-Generate-Certificate-Signing-Request","level":4,"type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Navigate to the ","type":"text"},{"type":"reference","identifier":"https:\/\/developer.apple.com\/ios\/manage\/overview\/index.action","isActive":true}]}]},{"content":[{"inlineContent":[{"text":"Select ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"Identifiers"}]},{"text":" in the left sidebar and filter ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"App Ids","type":"text"}]},{"text":" using the button on the right of the page ","type":"text"},{"identifier":"apns-certificate-identifiers-app-ids.png","type":"image"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Select your application.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Enable push notifications by checking the checkbox then click ","type":"text"},{"inlineContent":[{"text":"Edit","type":"text"}],"type":"emphasis"},{"text":" ","type":"text"},{"type":"image","identifier":"apns-certificate-app-id-config.png"}]}]},{"content":[{"inlineContent":[{"text":"Click Create Certificate under the Production SSL Certificate ","type":"text"},{"identifier":"apns-certificate-modal.png","type":"image"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"name":"Note","style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Production SSL Certificate","type":"text"}]},{"type":"text","text":" are suitable for App Store and TestFlight builds. Use a "},{"type":"strong","inlineContent":[{"text":"Development SSL Certificate","type":"text"}]},{"type":"text","text":" for development builds."}]}]}]}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Follow the instructions from the SSL certificate assistant."}]}]}],"type":"orderedList"},{"type":"aside","name":"Note","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"You must update your provisioning profile for the app after you create your SSL certificates. A simple “Refresh” in the organizer will accomplish this.","type":"text"}]}]},{"level":4,"type":"heading","anchor":"Step-2-Export-Certificate","text":"Step 2: Export Certificate"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Download the production push certificate that you just created and open it with the Keychain Access application.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In Keychain Access, click on My Certificates and locate your push certificate."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Export it as a "},{"type":"codeVoice","code":".p12"},{"type":"text","text":" file and use a temporary, unsecure password (you will need this password when uploading your certificate to Braze)."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Navigate to the "},{"isActive":true,"overridingTitle":"Settings","overridingTitleInlineContent":[{"text":"Settings","type":"text"}],"type":"reference","identifier":"https:\/\/dashboard-01.braze.com\/app_settings\/app_settings"},{"type":"text","text":" page in the dashboard and upload your production certificate. "},{"type":"image","identifier":"apns-certificate-upload.png"}],"type":"paragraph"}]}]},{"type":"aside","style":"note","content":[{"inlineContent":[{"type":"text","text":"You can upload either your development or production push certificates to the dashboard for your distribution provisioning profile apps, but you can onl