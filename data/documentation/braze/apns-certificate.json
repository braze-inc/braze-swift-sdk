{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Braze\/documentation\/Braze\/apns-certificate"},"hierarchy":{"paths":[["doc:\/\/Braze\/documentation\/BrazeKit"]]},"seeAlsoSections":[{"anchor":"Related-Documentation","title":"Related Documentation","identifiers":["doc:\/\/Braze\/tutorials\/Braze\/b1-standard-push-notifications"]},{"generated":true,"anchor":"Push-Notifications","title":"Push Notifications","identifiers":["doc:\/\/Braze\/tutorials\/Braze\/b1-standard-push-notifications","doc:\/\/Braze\/tutorials\/Braze\/b2-rich-push-notifications","doc:\/\/Braze\/tutorials\/Braze\/b3-push-stories","doc:\/\/Braze\/tutorials\/Braze\/b4-live-activities"]}],"kind":"article","abstract":[{"text":"Create an Apple Push file or certificate.","type":"text"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"BrazeKit"}],"title":"Apple Push Certificate"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Before you can send a push notification using Braze, you must provide your Push notification file or certificate from Apple. You may present either a "},{"type":"codeVoice","code":".p8"},{"type":"text","text":" file (recommended) or a "},{"type":"codeVoice","code":".p12"},{"type":"text","text":" certificate."}]},{"level":3,"anchor":"p8-File-recommended","type":"heading","text":".p8 File (recommended)"},{"type":"paragraph","inlineContent":[{"type":"text","text":"As described on this "},{"identifier":"https:\/\/help.apple.com\/developer-account\/#\/devcdfbb56a3","type":"reference","isActive":true},{"type":"text","text":":"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In your developer account, go to "},{"isActive":true,"type":"reference","identifier":"https:\/\/developer.apple.com\/account\/ios\/certificate"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Under Keys, select All and click the Add button (+) in the upper-right corner."}]}]},{"content":[{"inlineContent":[{"text":"Under Key Description, enter a unique name for the signing key.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Under Key Services, select the APNs checkbox, then click Continue. Click "},{"type":"emphasis","inlineContent":[{"text":"Confirm","type":"text"}]},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Note the Key ID. Click "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Download"}]},{"type":"text","text":" to generate and download the key now."}],"type":"paragraph"}]}],"type":"orderedList"},{"content":[{"inlineContent":[{"type":"text","text":"When you download the key, it is saved as a text file with a .p8 file extension. Save the file in a secure place because the key is "},{"type":"strong","inlineContent":[{"type":"text","text":"not saved in your developer account and you won’t be able to download it again"}]},{"type":"text","text":"."}],"type":"paragraph"}],"name":"Note","type":"aside","style":"note"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Navigate to the "},{"isActive":true,"type":"reference","identifier":"https:\/\/dashboard-01.braze.com\/app_settings\/app_settings"},{"type":"text","text":" page in the dashboard and upload the .p8 file."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"When prompted, also enter your app’s "},{"type":"reference","identifier":"https:\/\/developer.apple.com\/account\/ios\/identifier\/bundle\/","isActive":true},{"type":"text","text":", the "},{"type":"reference","identifier":"https:\/\/developer.apple.com\/account\/ios\/authkey","isActive":true},{"type":"text","text":" that you noted when generating the key, and your "},{"type":"reference","identifier":"