{"hierarchy":{"paths":[["doc:\/\/Braze\/documentation\/BrazeKit"]]},"abstract":[{"text":"Create an Apple Push file or certificate.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"Before you can send a push notification using Braze, you must provide your Push notification file or certificate from Apple. You may present either a ","type":"text"},{"code":".p8","type":"codeVoice"},{"text":" file (recommended) or a ","type":"text"},{"code":".p12","type":"codeVoice"},{"text":" certificate.","type":"text"}]},{"type":"heading","text":".p8 File (recommended)","anchor":"p8-File-recommended","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"As described on this "},{"type":"reference","identifier":"https:\/\/help.apple.com\/developer-account\/#\/devcdfbb56a3","isActive":true},{"type":"text","text":":"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"In your developer account, go to "},{"type":"reference","isActive":true,"identifier":"https:\/\/developer.apple.com\/account\/ios\/certificate"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Under Keys, select All and click the Add button (+) in the upper-right corner."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Under Key Description, enter a unique name for the signing key.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Under Key Services, select the APNs checkbox, then click Continue. Click ","type":"text"},{"inlineContent":[{"type":"text","text":"Confirm"}],"type":"emphasis"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Note the Key ID. Click ","type":"text"},{"inlineContent":[{"text":"Download","type":"text"}],"type":"emphasis"},{"text":" to generate and download the key now.","type":"te