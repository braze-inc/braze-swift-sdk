{"primaryContentSections":[{"content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Before you can send a push notification using Braze, you must provide your Push notification file or certificate from Apple. You may present either a "},{"type":"codeVoice","code":".p8"},{"type":"text","text":" file (recommended) or a "},{"type":"codeVoice","code":".p12"},{"type":"text","text":" certificate."}]},{"level":3,"type":"heading","anchor":"p8-File-recommended","text":".p8 File (recommended)"},{"type":"paragraph","inlineContent":[{"type":"text","text":"As described on this "},{"type":"reference","identifier":"https:\/\/help.apple.com\/developer-account\/#\/devcdfbb56a3","isActive":true},{"type":"text","text":":"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"In your developer account, go to "},{"isActive":true,"identifier":"https:\/\/developer.apple.com\/account\/ios\/certificate","type":"reference"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Under Keys, select All and click the Add button (+) in the upper-right corner.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Under Key Description, enter a unique name for the signing key."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Under Key Services, select the APNs checkbox, then click Continue. Click "},{"type":"emphasis","inlineContent":[{"text":"Confirm","type":"text"}]},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Note the Key ID. Click ","type":"text"},{"inlineContent":[{"type":"text","text":"Download"}],"type":"emphasis"},{"text":" to generate and download the key now.","type":"text"}]}]}],"type":"orderedList"},{"type":"aside","style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"When you download the key, it is saved as a text file with a .p8 file extension. Save the file in a secure place because the key is "},{"inlineContent":[{"type":"text","text":"not saved in your developer account and you won’t be able to download it again"}],"type":"strong"},{"type":"text","text":"."}]}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"Navigate to the ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/dashboard-01.braze.com\/app_settings\/app_settings"},{"text":" page in the dashboard and upload the .p8 file.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"When prompted, also enter your app’s "},{"type":"reference","identifier":"https:\/\/developer.apple.com\/account\/ios\/identifier\/bundle\/","isActive":true},{"type":"text","text":", the "},{"type":"reference","identifier":"https:\/\/developer.apple.com\/account\/ios\/authkey","isActive":true},{"type":"text","text":" that you noted when generating the key, and your "},{"type":"reference","identifier":"https:\/\/developer.apple.com\/account\/#\/membership","isActive":true},{"type":"text","text":". Click "},{"type":"emphasis","inlineContent":[{"text":"Save","type":"text"}]},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"type":"heading","level":3,"anchor":"p12-Certificate-legacy","text":".p12 Certificate (legacy)"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Alternatively, you may utilize Apple’s older authentication scheme ("},{"type":"codeVoice","code":".p12"},{"type":"text","text":" SSL certificates). Unlike the "},{"type":"codeVoice","code":".p8"},{"type":"text","text":" solution described above, these certificates automatically expire every year and will require you to regenerate and re-upload them. Braze will send you email reminders as the certificate approaches expiration to help your notifications continue uninterrupted, but because this is a manual process we recommend utilizing the above-described "},{"type":"codeVoice","code":".p8"},{"type":"text","text":" authentication scheme instead. However, if you still wish to, you may configure and upload "},{"type":"codeVoice","code":".p12"},{"type":"text","text":" certificates as described here:"}]},{"type":"heading","level":4,"anchor":"Step-1-Generate-Certificate-Signing-Request","text":"Step 1: Generate Certificate Signing Request"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Navigate to the ","type":"text"},{"isActive":true,"identifier":"https:\/\/developer.apple.com\/ios\/manage\/overview\/index.action","type":"reference"}]}]},{"content":[{"inlineContent":[{"text":"Select ","type":"text"},{"inlineContent":[{"type":"text","text":"Identifiers"}],"type":"emphasis"},{"text":" in the left sidebar and filter ","type":"text"},{"inlineContent":[{"type":"text","text":"App Ids"}],"type":"emphasis"},{"text":" using the button on the right of the page ","type":"text"},{"identifier":"apns-certificate-identifiers-app-ids.png","type":"image"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Select your application.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Enable push notifications by checking the checkbox then click "},{"inlineContent":[{"text":"Edit","type":"text"}],"type":"emphasis"},{"type":"text","text":" "},{"identifier":"apns-certificate-app-id-config.png","type":"image"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Click Create Certificate under the Production SSL Certificate ","type":"text"},{"identifier":"apns-certificate-modal.png","type":"image"}]},{"type":"unorderedList","items":[{"content":[{"style":"note","content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Production SSL Certificate"}],"type":"strong"},{"text":" are suitable for App Store and TestFlight builds. Use a ","type":"text"},{"inlineContent":[{"text":"Development SSL Certificate","type":"text"}],"type":"strong"},{"text":" for development builds.","type":"text"}]}],"type":"aside","name":"Note"}]}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Follow the instructions from the SSL certificate assistant."}]}]}]},{"type":"aside","style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You must update your provisioning profile for the app after you create your SSL certificates. A simple “Refresh” in the organizer will accomplish this."}]}]},{"type":"heading","level":4,"anchor":"Step-2-Export-Certificate","text":"Step 2: Export Certificate"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"Download the production push certificate that you just created and open it with the Keychain Access application.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In Keychain Access, click on My Certificates and locate your push certificate."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Export it as a "},{"type":"codeVoice","code":".p12"},{"type":"text","text":" file and use a temporary, unsecure password (you will need this password when uploading your certificate to Braze)."}]}]},{"content":[{"inlineContent":[{"text":"Navigate to the ","type":"text"},{"identifier":"https:\/\/dashboard-01.braze.com\/app_settings\/app_settings","isActive":true,"overridingTitleInlineContent":[{"text":"Settings","type":"text"}],"type":"reference","overridingTitle":"Settings"},{"text":" page in the dashboard and upload your production certificate. ","type":"text"},{"identifier":"apns-certificate-upload.png","type":"image"}],"type":"paragraph"}]}]},{"type":"aside","style":"note","name":"Note","content":[{"inlineContent":[{"type":"text","text":"You can upload either your development or production push certificates to the dashboard for your distribution provisioning profile apps, but you can only have one active at a time. As such, if you wish to do repeated testing of push notifications once your app goes live in the App Store, we recommend setting up a separate App Group or App for the development version of your app."}],"type":"paragraph"}]}],"kind":"content"}],"kind":"article","metadata":{"modules":[{"name":"BrazeKit"}],"roleHeading":"Article","title":"Apple Push Certificate","role":"article"},"sections":[],"hierarchy":{"paths":[["doc:\/\/Braze\/documentation\/BrazeKit"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Braze\/documentation\/Braze\/apns-certificate"},"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"Create an Apple Push file or certificate."}],"seeAlsoSections":[{"title":"Related Documentation","anchor":"Related-Documentation","identifiers":["doc:\/\/Braze\/tutorials\/Braze\/b1-standard-push-notifications"]},{"title":"Push Notifications","anchor":"Push-Notifications","identifiers":["doc:\/\/Braze\/tutorials\/Braze\/b1-standard-push-notifications","doc:\/\/Braze\/tutorials\/Braze\/b2-rich-push-notifications","doc:\/\/Braze\/tutorials\/Braze\/b3-push-stories","doc:\/\/Braze\/tutorials\/Braze\/b4-live-activities"],"generated":true}],"references":{"apns-certificate-upload.png":{"alt":"The Braze dashboard application push notification setting page","identifier":"apns-certificate-upload.png","variants":[{"url":"\/images\/Braze\/apns-certificate-upload.png","traits":["1x","light"]}],"type":"image"},"https://developer.apple.com/account/ios/identifier/bundle/":{"url":"https:\/\/developer.apple.com\/account\/ios\/identifier\/bundle\/","titleInlineContent":[{"type":"text","text":"Bundle ID"}],"identifier":"https:\/\/developer.apple.com\/account\/ios\/identifier\/bundle\/","title":"Bundle ID","type":"link"},"doc://Braze/documentation/BrazeKit":{"kind":"symbol","url":"\/documentation\/brazekit","role":"collection","abstract":[{"type":"text","text":"The main Braze framework providing user sessions, attribute