{"abstract":[{"type":"text","text":"Create an Apple Push file or certificate."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/Braze\/documentation\/BrazeKit"]]},"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Braze\/documentation\/Braze\/apns-certificate"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"text":"Before you can send a push notification using Braze, you must provide your Push notification file or certificate from Apple. You may present either a ","type":"text"},{"code":".p8","type":"codeVoice"},{"text":" file (recommended) or a ","type":"text"},{"code":".p12","type":"codeVoice"},{"text":" certificate.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"p8-File-recommended","text":".p8 File (recommended)","type":"heading"},{"inlineContent":[{"text":"As described on this ","type":"text"},{"identifier":"https:\/\/help.apple.com\/developer-account\/#\/devcdfbb56a3","type":"reference","isActive":true},{"text":":","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In your developer account, go to "},{"type":"reference","identifier":"https:\/\/developer.apple.com\/account\/ios\/certificate","isActive":true},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"text":"Under Keys, select All and click the Add button (+) in the upper-right corner.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Under Key Description, enter a unique name for the signing key.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Under Key Services, select the APNs checkbox, then click Continue. Click ","type":"text"},{"inlineContent":[{"text":"Confirm","type":"text"}],"type":"emphasis"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Note the Key ID. Click ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"Download","type":"text"}]},{"text":" to generate and download the key now.","type":"text"}]}]}],"type":"orderedList"},{"style":"note","content":[{"inlineContent":[{"type":"text","text":"When you download the key, it is saved as a text file with a .p8 file extension. Save the file in a secure place because the key is "},{"type":"strong","inlineContent":[{"text":"not saved in your developer account and you won’t be able to download it again","type":"text"}]},{"type":"text","text":"."}],"type":"paragraph"}],"name":"Note","type":"aside"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Navigate to the "},{"identifier":"https:\/\/dashboard-01.braze.com\/app_settings\/app_settings","type":"reference","isActive":true},{"type":"text","text":" page in the dashboard and upload the .p8 file."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"When prompted, also enter your app’s ","type":"text"},{"isActive":true,"identifier":"https:\/\/developer.apple.com\/account\/ios\/identifier\/bundle\/","type":"reference"},{"text":", the ","type":"text"},{"isActive":true,"identifier":"https:\/\/developer.apple.com\/account\/ios\/authkey","type":"reference"},{"text":" that you noted when generating the key, and your ","type":"text"},{"isActive":true,"identifier":"https:\/\/developer.apple.com\/account\/#\/membership","type":"reference"},{"text":". Click ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"Save","type":"text"}]},{"text":".","type":"text"}]}]}],"type":"orderedList"},{"level":3,"anchor":"p12-Certificate-legacy","text":".p12 Certificate (legacy)","type":"heading"},{"inlineContent":[{"type":"text","text":"Alternatively, you may utilize Apple’s older authentication scheme ("},{"code":".p12","type":"codeVoice"},{"type":"text","text":" SSL certificates). Unlike the "},{"code":".p8","type":"codeVoice"},{"type":"text","text":" solution described above, these certificates automatically expire every year and will require you to regenerate and re-upload them. Braze will send you email reminders as the certificate approaches expiration to help your notifications continue uninterrupted, but because this is a manual process we recommend utilizing the above-described "},{"code":".p8","type":"codeVoice"},{"type":"text","text":" authentication scheme instead. However, if you still wish to, you may configure and upload "},{"code":".p12","type":"codeVoice"},{"type":"text","text":" certificates as described here:"}],"type":"paragraph"},{"level":4,"anchor":"Step-1-Generate-Certificate-Signing-Request","text":"Step 1: Generate Certificate Signing Request","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Navigate to the "},{"identifier":"https:\/\/developer.apple.com\/ios\/manage\/overview\/index.action","isActive":true,"type":"reference"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Select ","type":"text"},{"inlineContent":[{"type":"text","text":"Identifiers"}],"type":"emphasis"},{"text":" in the left sidebar and filter ","type":"text"},{"inlineContent":[{"type":"text","text":"App Ids"}],"type":"emphasis"},{"text":" using the button on the right of the page ","type":"text"},{"type":"image","identifier":"apns-certificate-identifiers-app-ids.png"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Select your application."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Enable push notifications by checking the checkbox then click "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Edit"}]},{"type":"text","text":" "},{"type":"image","identifier":"apns-certificate-app-id-config.png"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Click Create Certificate under the Production SSL Certificate "},{"identifier":"apns-certificate-modal.png","type":"image"}],"type":"paragraph"},{"items":[{"content":[{"style":"note","content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Production SSL Certificate","type":"text"}]},{"type":"text","text":" are suitable for App Store and TestFlight builds. Use a "},{"type":"strong","inlineContent":[{"text":"Development SSL Certificate","type":"text"}]},{"type":"text","text":" for development builds."}],"type":"paragraph"}],"name":"Note","type":"aside"}]}],"type":"unorderedList"}]},{"content":[{"inlineContent":[{"type":"text","text":"Follow the instructions from the SSL certificate assistant."}],"type":"paragraph"}]}],"type":"orderedList"},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":"You must update your provisioning profile for the app after you create your SSL certificates. A simple “Refresh” in the organizer will accomplish this."}],"type":"paragraph"}],"style":"note","name":"Note"},{"text":"Step 2: Export Certificate","anchor":"Step-2-Export-Certificate","level":4,"type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Download the production push certificate that you just created and open it with the Keychain Access application.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"In Keychain Access, click on My Certificates and locate your push certificate.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Export it as a "},{"type":"codeVoice","code":".p12"},{"type":"text","text":" file and use a temporary, unsecure password (you will need this password when uploading your certificate to Braze)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Navigate to the "},{"type":"reference","overridingTitleInlineContent":[{"type":"text","text":"Settings"}],"overridingTitle":"Settings","isActive":true,"identifier":"https:\/\/dashboard-01.braze.com\/app_settings\/app_settings"},{"type":"text","text":" page in the dashboard and upload your production certificate. "},{"