"}]},{"type":"text","text":" are suitable for App Store and TestFlight builds. Use a "},{"type":"strong","inlineContent":[{"type":"text","text":"Development SSL Certificate"}]},{"type":"text","text":" for development builds."}],"type":"paragraph"}],"style":"note"}]}],"type":"unorderedList"}]},{"content":[{"inlineContent":[{"type":"text","text":"Follow the instructions from the SSL certificate assistant."}],"type":"paragraph"}]}]},{"style":"note","name":"Note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You must update your provisioning profile for the app after you create your SSL certificates. A simple “Refresh” in the organizer will accomplish this."}]}]},{"text":"Step 2: Export Certificate","anchor":"Step-2-Export-Certificate","level":4,"type":"heading"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"Download the production push certificate that you just created and open it with the Keychain Access application.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"In Keychain Access, click on My Certificates and locate your push certificate.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Export it as a "},{"type":"codeVoice","code":".p12"},{"type":"text","text":" file and use a temporary, unsecure password (you will need this password when uploading your certificate to Braze)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Navigate to the "},{"overridingTitle":"Settings","identifier":"https:\/\/dashboard-01.braze.com\/app_settings\/app_settings","type":"reference","isActive":true,"overridingTitleInlineContent":[{"text":"Settings","type":"text"}]},{"type":"text","text":" page in the dashboard and upload your production certificate. "},{"identifier":"apns-certificate-upload.png","type":"image"}],"type":"paragraph"}]}]},{"style":"note","name":"Note","type":"aside","content":[{"inlineContent":[{"type":"te