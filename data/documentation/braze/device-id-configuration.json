{"hierarchy":{"paths":[["doc:\/\/Braze\/documentation\/BrazeKit"]]},"sections":[],"seeAlsoSections":[{"generated":true,"title":"Customize Behavior","identifiers":["doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/Configuration-swift.class","doc:\/\/Braze\/documentation\/BrazeKit\/BrazeDelegate","doc:\/\/Braze\/documentation\/BrazeKit\/overrideResourceBundle"],"anchor":"Customize-Behavior"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Braze\/documentation\/Braze\/device-id-configuration"},"kind":"article","abstract":[{"text":"Configuring your user’s device ID with ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/Configuration-swift.class\/useUUIDAsDeviceId"},{"text":".","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"inlineContent":[{"type":"text","text":"In "},{"type":"codeVoice","code":"BrazeKit"},{"type":"text","text":", a user can be identified using one of two device ID options:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Apple’s "},{"type":"reference","isActive":true,"identifier":"https:\/\/developer.apple.com\/documentation\/uikit\/uidevice\/1620059-identifierforvendor"},{"type":"text","text":" property."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"A randomly generated UUID.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Because "},{"type":"codeVoice","code":"identifierForVendor"},{"type":"text","text":" may not be available in all scenarios or devices, Braze provides the option to use a more generic UUID to identify a user’s device."}],"type":"paragraph"},{"type":"aside","name":"Important","content":[{"inlineContent":[{"type":"text","text":"The below configuration ("},{"identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/Configuration-swift.class\/useUUIDAsDeviceId","type":"reference","isActive":true},{"type":"text","text":") is deprecated and will be removed in a future major release. After removal, the SDK will always use a randomly generated UUID as the device ID. Device IDs previously persisted from the "},{"type":"codeVoice","code":"identifierForVendor"},{"type":"text","text":" continue to be respected until local persistence is cleared, at which point the device moves to a UUID-based device ID."}],"type":"paragraph"}],"style":"important"},{"level":2,"type":"heading","anchor":"Setting-Your-Configuration","text":"Setting Your Configuration"},{"inlineContent":[{"text":"To configure this option, set ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/Configuration-swift.class\/useUUIDAsDeviceId"},{"text":" under ","type":"text"},{"type":"codeVoice","code":"Braze.Configuration"},{"text":". Assigning this property to ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" will generate a random UUID for each user installation, whereas a value of ","type":"text"},{"type":"codeVoice","code":"false"},{"text":" will notify the SDK to use the device’s ","type":"text"},{"type":"codeVoice","code":"identifierForVendor"},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let configuration = Braze.Configuration(","    apiKey: \"<BRAZE_API_KEY>\",","    endpoint: \"<BRAZE_ENDPOINT>\"",")","\/\/ Set this value to `true` to opt out of `identifierForVendor` usage.","configuration.useUUIDAsDeviceId = true","let braze = Braze(configuration: configuration)"]},{"inlineContent":[{"type":"text","text":"Starting in 7.0.0, the default value for this property is "},{"type":"codeVoice","code":"true"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For device types that do not support "},{"type":"codeVoice","code":"identifierForVendor"},{"type":"text","text":", such as watchOS or macOS, Braze will default to a randomly generated UUID regardless of which option is configured."}]}],"style":"note"},{"inlineContent":[{"type":"text","text":"After being generated, device IDs created from UUIDs will remain consistent throughout the lifetime of the application’s installation or until "},{"type":"reference","identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/wipeData()","isActive":true},{"type":"text","text":" is called."}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"Since calling ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/wipeData()","type":"reference"},{"text":" will erase all local SDK storage, the device ID that was previously stored will be deleted. Thus, if ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/Configuration-swift.class\/useUUIDAsDeviceId","type":"reference"},{"text":" is enabled, the SDK will generate a new UUID for the device ID after this operation. Similarly, if ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/Configuration-swift.class\/useUUIDAsDeviceId","type":"reference"},{"text":" is disabled, the SDK will re-use the same IDFV after this operation.","type":"text"}],"type":"paragraph"}],"type":"aside","name":"Important","style":"important"},{"text":"Migrating from a Previous Version","type":"heading","level":2,"anchor":"Migrating-from-a-Previous-Version"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you are migrating your project from the legacy "},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/Appboy\/appboy-ios-sdk"},{"type":"text","text":" or from a version of the Braze Swift SDK prior to "},{"type":"codeVoice","code":"5.7.0"},{"type":"text","text":", note that the "},{"type":"codeVoice","code":"identifierForVendor"},{"type":"text","text":" option will be used by default, regardless of the configuration setting. This ensures continuity for any anonymous users previously identified by the "},{"type":"codeVoice","code":"identifierForVendor"},{"type":"text","text":" device ID."}]},{"type":"paragraph","inlineContent":[{"text":"In such cases, if you wish to override those pre-existing values and ensure that your ","type":"text"},{"identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/Configuration-swift.class\/useUUIDAsDeviceId","isActive":true,"type":"reference"},{"text":" configuration is respected, call ","type":"text"},{"identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/wipeData()","isActive":true,"type":"reference"},{"text":" on the ","type":"text"},{"code":"Braze","type":"codeVoice"},{"text":" instance after migrating to any version of the Braze Swift SDK from ","type":"text"},{"code":"5.7.0","type":"codeVoice"},{"text":" onwards.","type":"text"}]}]}],"metadata":{"roleHeading":"Article","role":"article","title":"Device ID Configuration","modules":[{"name":"BrazeKit"}]},"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://Braze/documentation/BrazeKit/Braze":{"url":"\/documentation\/brazekit\/braze","abstract":[{"type":"reference","identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze","isActive":true},{"text":" is the main entry point of the BrazeKit module and provides access to all its features.","type":"text"}],"type":"topic","kind":"symbol","title":"Braze","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Braze","kind":"identifier"}],"navigatorTitle":[{"text":"Braze","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze"},"https://developer.apple.com/documentation/uikit/uidevice/1620059-identifierforvendor":{"url":"https:\/\/developer.apple.com\/documentation\/uikit\/uidevice\/1620059-identifierforvendor","title":"UIDevice.identifierForVendor","titleInlineContent":[{"type":"codeVoice","code":"UIDevice.identifierForVendor"}],"t