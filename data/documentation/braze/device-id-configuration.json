{"hierarchy":{"paths":[["doc:\/\/Braze\/documentation\/BrazeKit"]]},"seeAlsoSections":[{"title":"Customize Behavior","identifiers":["doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/Configuration-swift.class","doc:\/\/Braze\/documentation\/BrazeKit\/BrazeDelegate","doc:\/\/Braze\/documentation\/BrazeKit\/overrideResourceBundle"],"anchor":"Customize-Behavior","generated":true}],"sections":[],"metadata":{"modules":[{"name":"BrazeKit"}],"roleHeading":"Article","title":"Device ID Configuration","role":"article"},"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"text":"In ","type":"text"},{"type":"codeVoice","code":"BrazeKit"},{"text":", a user can be identified using one of two device ID options:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Apple’s "},{"isActive":true,"type":"reference","identifier":"https:\/\/developer.apple.com\/documentation\/uikit\/uidevice\/1620059-identifierforvendor"},{"type":"text","text":" property."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A randomly generated UUID."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Because "},{"code":"identifierForVendor","type":"codeVoice"},{"type":"text","text":" may not be available in all scenarios or devices, Braze provides the option to use a more generic UUID to identify a user’s device."}],"type":"paragraph"},{"name":"Important","content":[{"type":"paragraph","inlineContent":[{"text":"The below configuration (","type":"text"},{"isActive":true,"identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/Configuration-swift.class\/useUUIDAsDeviceId","type":"reference"},{"text":") is deprecated and will be removed in a future major release. After removal, the SDK will always use a randomly generated UUID as the device ID. Device IDs previously persisted from the ","type":"text"},{"code":"identifierForVendor","type":"codeVoice"},{"text":" continue to be respected until local persistence is cleared, at which point the device moves to a UUID-based device ID.","type":"text"}]}],"type":"aside","style":"important"},{"level":2,"anchor":"Setting-Your-Configuration","text":"Setting Your Configuration","type":"heading"},{"inlineContent":[{"type":"text","text":"To configure this option, set "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/Configuration-swift.class\/useUUIDAsDeviceId"},{"type":"text","text":" under "},{"type":"codeVoice","code":"Braze.Configuration"},{"type":"text","text":". Assigning this property to "},{"type":"codeVoice","code":"true"},{"type":"text","text":" will generate a random UUID for each user installation, whereas a value of "},{"type":"codeVoice","code":"false"},{"type":"text","text":" will notify the SDK to use the device’s "},{"type":"codeVoice","code":"identifierForVendor"},{"type":"text","text":"."}],"type":"paragraph"},{"code":["let configuration = Braze.Configuration(","    apiKey: \"<BRAZE_API_KEY>\",","    endpoint: \"<BRAZE_ENDPOINT>\"",")","\/\/ Set this value to `true` to opt out of `identifierForVendor` usage.","configuration.useUUIDAsDeviceId = true","let braze = Braze(configuration: configuration)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Starting in 7.0.0, the default value for this property is "},{"type":"codeVoice","code":"true"},{"type":"text","text":"."}],"type":"paragraph"},{"name":"Note","content":[{"inlineContent":[{"text":"For device types that do not support ","type":"text"},{"type":"codeVoice","code":"identifierForVendor"},{"text":", such as watchOS or macOS, Braze will default to a randomly generated UUID regardless of which option is configured.","type":"text"}],"type":"paragraph"}],"type":"aside","style":"note"},{"inlineContent":[{"text":"After being generated, device IDs created from UUIDs will remain consistent throughout the lifetime of the application’s installation or until ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/wipeData()"},{"text":" is called.","type":"text"}],"type":"paragraph"},{"style":"important","name":"Important","content":[{"inlineContent":[{"type":"text","text":"Since calling "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/wipeData()"},{"type":"text","text":" will erase all local SDK storage, the device ID that was previously stored will be deleted. Thus, if "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/Configuration-swift.class\/useUUIDAsDeviceId"},{"type":"text","text":" is enabled, the SDK will generate a new UUID for the device ID after this operation. Similarly, if "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/Configuration-swift.class\/useUUIDAsDeviceId"},{"type":"text","text":" is disabled, the SDK will re-use the same IDFV after this operation."}],"type":"paragraph"}],"type":"aside"},{"anchor":"Migrating-from-a-Previous-Version","level":2,"text":"Migrating from a Previous Version","type":"heading"},{"inlineContent":[{"type":"text","text":"If you are migrating your project from the legacy "},{"type":"reference","identifier":"https:\/\/github.com\/Appboy\/appboy-ios-sdk","isActive":true},{"type":"text","text":" or from a version of the Braze Swift SDK prior to "},{"type":"codeVoice","code":"5.7.0"},{"type":"text","text":", note that the "},{"type":"codeVoice","code":"identifierForVendor"},{"type":"text","text":" option will be used by default, regardless of the configuration setting. This ensures continuity for any anonymous users previously identified by the "},{"type":"codeVoice","code":"identifierForVendor"},{"type":"text","text":" device ID."}],"type":"paragraph"},{"inlineC