{"kind":"article","seeAlsoSections":[{"identifiers":["doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/Configuration-swift.class","doc:\/\/Braze\/documentation\/BrazeKit\/BrazeDelegate","doc:\/\/Braze\/documentation\/BrazeKit\/overrideResourceBundle"],"generated":true,"title":"Customize Behavior","anchor":"Customize-Behavior"}],"hierarchy":{"paths":[["doc:\/\/Braze\/documentation\/BrazeKit"]]},"metadata":{"title":"Device ID Configuration","modules":[{"name":"BrazeKit"}],"roleHeading":"Article","role":"article"},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"text":"In ","type":"text"},{"type":"codeVoice","code":"BrazeKit"},{"text":", a user can be identified using one of two device ID options:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Apple’s "},{"type":"reference","isActive":true,"identifier":"https:\/\/developer.apple.com\/documentation\/uikit\/uidevice\/1620059-identifierforvendor"},{"type":"text","text":" property."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A randomly generated UUID.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Because ","type":"text"},{"code":"identifierForVendor","type":"codeVoice"},{"text":" may not be available in all scenarios or devices, Braze provides the option to use a more generic UUID to identify a user’s device.","type":"text"}],"type":"paragraph"},{"name":"Important","content":[{"inlineContent":[{"text":"The below configuration (","type":"text"},{"isActive":true,"identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/Configuration-swift.class\/useUUIDAsDeviceId","type":"reference"},{"text":") is deprecated and will be removed in a future major release. After removal, the SDK will always use a randomly generated UUID as the device ID. Device IDs previously persisted from the ","type":"text"},{"code":"identifierForVendor","type":"codeVoice"},{"text":" continue to be respected until local persistence is cleared, at which point the device moves to a UUID-based device ID.","type":"text"}],"type":"paragraph"}],"type":"aside","style":"important"},{"text":"Setting Your Configuration","anchor":"Setting-Your-Configuration","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"To configure this option, set "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/Configuration-swift.class\/useUUIDAsDeviceId"},{"type":"text","text":" under "},{"type":"codeVoice","code":"Braze.Configuration"},{"type":"text","text":". Assigning this property to "},{"type":"codeVoice","code":"true"},{"type":"text","text":" will generate a random UUID for each user installation, whereas a value of "},{"type":"codeVoice","code":"false"},{"type":"text","text":" will notify the SDK to use the device’s "},{"type":"codeVoice","code":"identifierForVendor"},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"swift","code":["let configuration = Braze.Configuration(","    apiKey: \"<BRAZE_API_KEY>\",","    endpoint: \"<BRAZE_ENDPOINT>\"",")","\/\/ Set this value to `true` to opt out of `identifierForVendor` usage.","configuration.useUUIDAsDeviceId = true","let braze = Braze(configuration: configuration)"],"type":"codeListing"},{"inlineContent":[{"text":"Starting in 7.0.0, the default value for this property is ","type":"text"},{"type":"codeVoice","code":"true"},{"text":".","type":"text"}],"type":"paragraph"},{"name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For device types that do not support "},{"type":"codeVoice","code":"identifierForVendor"},{"type":"text","text":", such as watchOS or macOS, Braze will default to a randomly generated UUID regardless of which option is configured."}]}],"type":"aside","style":"note"},{"inlineContent":[{"type":"text","text":"After being generated, device IDs created from UUIDs will remain consistent throughout the lifetime of the application’s installation or until "},{"type":"reference","identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/wipeData()","isActive":true},{"type":"text","text":" is called."}],"type":"paragraph"},{"name":"Important","style":"important","type":"aside","content":[{"inlineContent":[{"type":"text","text":"Since calling "},{"type":"reference","identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/wipeData()","isActive":true},{"type":"text","text":" will erase all local SDK storage, the device ID that was previously stored will be deleted. Thus, if "},{"type":"reference","identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/Configuration-swift.class\/useUUIDAsDeviceId","isActive":true},{"type":"text","text":" is enabled, the SDK will generate a new UUID for the device ID after this operation. Similarly, if "},{"type":"reference","identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/Configuration-swift.class\/useUUIDAsDeviceId","isActive":true},{"type":"text","text":" is disabled, the SDK will re-use the same IDFV after this operation."}],"type":"paragraph"}]},{"anchor":"Migrating-from-a-Previous-Version","text":"Migrating from a Previous Version","type":"heading","level":2},{"inlineContent":[{"text":"If you are migrating your project from the legacy ","type":"text"},{"type":"reference","identifier":"https:\/\/github.com\/Appboy\/appboy-ios-sdk","isActive":true},{"text":" or from a version of the Braze Swift SDK prior to ","type":"text"},{"code":"5.7.0","type":"codeVoice"},{"text":", note that the ","type":"text"},{"code":"identifierForVendor","type":"codeVoice"},{"text":" option will be used by default, regardless of the configuration setting. This ensures continuity for any anonymous users previously identified by the ","type":"text"},{"code":"identifierForVendor","type":"codeVoice"},{"text":" device ID.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"In such cases, if you wish to override those pre-existing values and ensure that your "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/Configuration-swift.class\/useUUIDAsDeviceId"},{"type":"text","text":" configuration is respected, call "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/wipeData()"},{"type":"text","text":" on the "},{"type":"codeVoice","code":"Braze"},{"type":"text","text":" instance after migrating to any version of the Braze Swift SDK from "},{"type":"codeVoice","code":"5.7.0"},{"type":"text","text":" onwards."}],"type":"paragraph"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Braze\/documentation\/Braze\/device-id-configuration"},"abstract":[{"type":"text","text":"Configuring your user’s device ID with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/Configuration-swift.class\/useUUIDAsDeviceId"},{"type":"text","text":"."}],"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://Braze/documentation/BrazeKit/overrideResourceBundle":{"title":"overrideResourceBundle","identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/overrideResourceBundle","type":"topic","url":"\/documentation\/brazekit\/overrideresourcebundle","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/overrideResourcesBundle"},{"type":"text","text":"."}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"overrideResourceBundle","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bundle","kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)NSBundle"},{"text":"?","kind":"text"}]},"doc://Braze/documentation/BrazeKit/Braze/enabled":{"type":"topic","role":"symbol","abstract":[{"text":"Specify whether the Braze SDK is enabled or not.","type":"text"}],"title":"enabl