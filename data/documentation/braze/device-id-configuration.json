{"kind":"article","sections":[],"identifier":{"url":"doc:\/\/Braze\/documentation\/Braze\/device-id-configuration","interfaceLanguage":"swift"},"abstract":[{"text":"Configuring your user’s device ID with ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/Configuration-swift.class\/useUUIDAsDeviceId","type":"reference"},{"text":".","type":"text"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"role":"article","title":"Device ID Configuration","modules":[{"name":"BrazeKit"}],"roleHeading":"Article"},"hierarchy":{"paths":[["doc:\/\/Braze\/documentation\/BrazeKit"]]},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"In "},{"code":"BrazeKit","type":"codeVoice"},{"type":"text","text":", a user can be identified using one of two device ID options:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Apple’s "},{"type":"reference","isActive":true,"identifier":"https:\/\/developer.apple.com\/documentation\/uikit\/uidevice\/1620059-identifierforvendor"},{"type":"text","text":" property."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A randomly generated UUID.","type":"text"}]}]}]},{"inlineContent":[{"type":"text","text":"Because "},{"code":"identifierForVendor","type":"codeVoice"},{"type":"text","text":" may not be available in all scenarios or devices, Braze provides the option to use a more generic UUID to identify a user’s device."}],"type":"paragraph"},{"anchor":"Setting-Your-Configuration","level":2,"text":"Setting Your Configuration","type":"heading"},{"inlineContent":[{"type":"text","text":"To configure this option, set "},{"type":"reference","identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/Configuration-swift.class\/useUUIDAsDeviceId","isActive":true},{"type":"text","text":" under "},{"type":"codeVoice","code":"Braze.Configuration"},{"type":"text","text":". Assigning this property to "},{"type":"codeVoice","code":"true"},{"type":"text","text":" will generate a random UUID for each user installation, whereas a value of "},{"type":"codeVoice","code":"false"},{"type":"text","text":" will notify the SDK to use the device’s "},{"type":"codeVoice","code":"identifierForVendor"},{"type":"text","text":"."}],"type":"paragraph"},{"code":["let configuration = Braze.Configuration(","    apiKey: \"<BRAZE_API_KEY>\",","    endpoint: \"<BRAZE_ENDPOINT>\"",")","\/\/ Set this value to `true` to opt out of `identifierForVendor` usage.","configuration.useUUIDAsDeviceId = true","let braze = Braze(configuration: configuration)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Starting in 7.0.0, the default value for this property is "},{"type":"codeVoice","code":"true"},{"type":"text","text":"."}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"For device types that do not support ","type":"text"},{"type":"codeVoice","code":"identifierForVendor"},{"text":", such as watchOS or macOS, Braze will default to a randomly generated UUID regardless of which option is configured.","type":"text"}],"type":"paragraph"}],"style":"note","type":"aside","name":"Note"},{"inlineContent":[{"type":"text","text":"After being generated, device IDs created from UUIDs will remain consistent throughout the lifetime of the application’s installation or until "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/wipeData()"},{"type":"text","text":" is called."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Since calling ","type":"text"},{"identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/wipeData()","isActive":true,"type":"reference"},{"text":" will erase all local SDK storage, the device ID that was previously stored will be deleted. Thus, if ","type":"text"},{"identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/Configuration-swift.class\/useUUIDAsDeviceId","isActive":true,"type":"reference"},{"text":" is enabled, the SDK will generate a new UUID for the device ID after this operation. Similarly, if ","type":"text"},{"identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/Configuration-swift.class\/useUUIDAsDeviceId","isActive":true,"type":"reference"},{"text":" is disabled, the SDK will re-use the same IDFV after this operation.","type":"text"}]}],"style":"important","type":"aside","name":"Important"},{"anchor":"Migrating-from-a-Previous-Version","level":2,"text":"Migrating from a Previous Version","type":"heading"},{"inlineContent":[{"text":"If you are migrating your project from the legacy ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/Appboy\/appboy-ios-sdk"},{"text":" or from a version of the Braze Swift SDK prior to ","type":"text"},{"code":"5.7.0","type":"codeVoice"},{"text":", note that the ","type":"text"},{"code":"identifierForVendor","type":"codeVoice"},{"text":" option will be used by default, regardless of the configuration setting. This ensures continuity for any anonymous users previously identified by the ","type":"text"},{"code":"identifierForVendor","type":"codeVoice"},{"text":" device ID.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"In such cases, if you wish to override those pre-existing values and ensure that your ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/Configuration-swift.class\/useUUIDAsDeviceId"},{"text":" configuration is respected, call ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/wipeData()"},{"text":" on the ","type":"text"},{"type":"codeVoice","code":"Braze"},{"text":" instance after migrating to any version of the Braze Swift SDK from ","type":"text"},{"type":"codeVoice","code":"5.7.0"},{"text":" onwards.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"seeAlsoSections":[{"identifiers":["doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/Configuration-swift.class","doc:\/\/Braze\/documentation\/BrazeKit\/BrazeDelegate","doc:\/\/Braze\/documentation\/BrazeKit\/overrideResourceBundle"],"anchor":"Customize-Behavior","title":"Customize Behavior","generated":true}],"references":{"https://developer.apple.com/documentation/uikit/uidevice/1620059-identifierforvendor":{"identifier":"https:\/\/developer.apple.com\/documentation\/uikit\/uidevice\/1620059-identifierforvendor","url":"https:\/\/developer.apple.com\/documentation\/uikit\/uidevice\/1620059-identifierforvendor","titleInlineContent":[{"code":"UIDevice.identifierForVendor","type":"codeVoice"}],"type":"link","title":"UIDevice.identifierForVendor"},"doc://Braze/documentation/BrazeKit/BrazeDelegate":{"type":"topic","identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/BrazeDelegate","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BrazeDelegate","kind":"identifier"}],"abstract":[{"type":"text","text":"Delegate for "},{"type":"reference","identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze","isActive":true},{"type":"text","text":" that can optionally react to the SDK lifecycle events (e.g. SDK opening"},{"type":"text","text":" "},{"type":"text","text":"a URL, presenting a web view, etc.)"}],"kind":"symbol","url":"\/documentation\/brazekit\/brazedelegate","title":"BrazeDelegate","role":"symbol","navigatorTitle":[{"text":"BrazeDelegate","kind":"identifier"}]},"https://github.com/Appboy/appboy-ios-sdk":{"identifier":"https:\/\/github.com\/Appboy\/appboy-ios-sdk","url":"https:\/\/github.com\/Appboy\/appboy-ios-sdk","titleInlineContent":[{"text":"AppboyKit SDK","type":"text"}],"type":"link","title":"AppboyKit SDK"},"doc://Braze/documentation/BrazeKit/overrideResourcesBundle":{"abstract":[{"text":"The override bundle BrazeKit uses to load resources (default: ","type":"text"},{"code":"n