{"abstract":[{"type":"text","text":"Configuring your user’s device ID with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/Configuration-swift.class\/useUUIDAsDeviceId"},{"type":"text","text":"."}],"metadata":{"title":"Device ID Configuration","role":"article","roleHeading":"Article","modules":[{"name":"BrazeKit"}]},"hierarchy":{"paths":[["doc:\/\/Braze\/documentation\/BrazeKit"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Braze\/documentation\/Braze\/device-id-configuration"},"kind":"article","primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In "},{"code":"BrazeKit","type":"codeVoice"},{"type":"text","text":", a user can be identified using one of two device ID options:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Apple’s ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/developer.apple.com\/documentation\/uikit\/uidevice\/1620059-identifierforvendor"},{"text":" property.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"A randomly generated UUID."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Because "},{"type":"codeVoice","code":"identifierForVendor"},{"type":"text","text":" may not be available in all scenarios or devices, Braze provides the option to use a more generic UUID to identify a user’s device."}]},{"style":"important","type":"aside","name":"Important","content":[{"inlineContent":[{"text":"The below configuration (","type":"text"},{"isActive":true,"identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/Configuration-swift.class\/useUUIDAsDeviceId","type":"reference"},{"text":") is deprecated and will be removed in a future major release. After removal, the SDK will always use a randomly generated UUID as the device ID. Device IDs previously persisted from the ","type":"text"},{"code":"identifierForVendor","type":"codeVoice"},{"text":" continue to be respected until local persistence is cleared, at which point the device moves to a UUID-based device ID.","type":"text"}],"type":"paragraph"}]},{"text":"Setting Your Configuration","type":"heading","level":2,"anchor":"Setting-Your-Configuration"},{"type":"paragraph","inlineContent":[{"text":"To configure this option, set ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/Configuration-swift.class\/useUUIDAsDeviceId","type":"reference"},{"text":" under ","type":"text"},{"code":"Braze.Configuration","type":"codeVoice"},{"text":". Assigning this property to ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" will generate a random UUID for each user installation, whereas a value of ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" will notify the SDK to use the device’s ","type":"text"},{"code":"identifierForVendor","type":"codeVoice"},{"text":".","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let configuration = Braze.Configuration(","    apiKey: \"<BRAZE_API_KEY>\",","    endpoint: \"<BRAZE_ENDPOINT>\"",")","\/\/ Set this value to `true` to opt out of `identifierForVendor` usage.","configuration.useUUIDAsDeviceId = true","let braze = Braze(configuration: configuration)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Starting in 7.0.0, the default value for this property is "},{"type":"codeVoice","code":"true"},{"type":"text","text":"."}]},{"style":"note","type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For device types that do not support "},{"code":"identifierForVendor","type":"codeVoice"},{"type":"text","text":", such as watchOS or macOS, Braze will default to a randomly generated UUID regardless of which option is configured."}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"After being generated, device IDs created from UUIDs will remain consistent throughout the lifetime of the application’s installation or until "},{"type":"reference","identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/wipeData()","isActive":true},{"type":"text","text":" is called."}]},{"style":"important","type":"aside","name":"Important","content":[{"type":"paragraph","inlineContent":[{"text":"Since calling ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/wipeData()","type":"reference"},{"text":" will erase all local SDK storage, the device ID that was previously stored will be deleted. Thus, if ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/Configuration-swift.class\/useUUIDAsDeviceId","type":"reference"},{"text":" is enabled, the SDK will generate a new UUID for the device ID after this operation. Similarly, if ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/Configuration-swift.class\/useUUIDAsDeviceId","type":"reference"},{"text":" is disabled, the SDK will re-use the same IDFV after this operation.","type":"text"}]}]},{"text":"Migrating from a Previous Version","type":"heading","level":2,"anchor":"Migrating-from-a-Previous-Version"},{"type":"paragraph","inlineContent":[{"text":"If you are migrating your project from the legacy ","type":"text"},{"identifier":"https:\/\/github.com\/Appboy\/appboy-ios-sdk","type":"reference","isActive":true},{"text":" or from a version of the Braze Swift SDK prior to ","type":"text"},{"code":"5.7.0","type":"codeVoice"},{"text":", note that the ","type":"text"},{"code":"identifierForVendor","type":"codeVoice"},{"text":" option will be used by default, regardless of the configuration setting. This ensures continuity for any anonymous users previously identified by the ","type":"text"},{"code":"identifierForVendor","type":"codeVoice"},{"text":" device ID.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In such cases, if you wish to override those pre-existing values and ensure that your "},{"type":"reference","identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/Configuration-swift.class\/useUUIDAsDeviceId","isActive":true},{"type":"text","text":" configuration is respected, call "},{"type":"reference","identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/wipeData()","isActive":true},{"type":"text","text":" on the "},{"type":"codeVoice","code":"Braze"},{"type":"text","text":" instance after migrating to any version of the Braze Swift SDK from "},{"type":"codeVoice","code":"5.7.0"},{"type":"text","text":" onwards."}]}],"kind":"content"}],"seeAlsoSections":[{"generated":true,"title":"Customize Behavior","identifiers":["doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/Configuration-swift.class","doc:\/\/Braze\/documentation\/BrazeKit\/BrazeDelegate","doc:\/\/Braze\/documentation\/BrazeKit\/overrideResourceBundle"],"anchor":"Customize-Behavior"}],"references":{"doc://Braze/documentation/BrazeKit/Braze":{"title":"Braze","identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze","role":"symbol","kind":"symbol","abstract":[{"identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze","type":"reference","isActive":true},{"type":"text","text":" is the main entry point of the BrazeKit module and provides access to all its features."}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Braze","kind":"identifier"}],"type":"topic","url":"\/documentation\/brazekit\/braze","navigatorTitle":[{"text":"Braze","kind":"identifier"}]},"doc://Braze/documentation/BrazeKit/Braze/Configuration-swift.class/useUUIDAsDeviceId":{"kind":"symbol","title":"useUUIDAsDeviceId","type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"useUUIDAsDeviceId"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"role":"symbol","deprecated":true,"identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/Configuration-swift.class\/useUUIDAsDeviceId","abstract":[{"type":"text","text":"Determines if a randomly generated UUID should be used as the device ID"}],"url":"\/documentation\/brazekit\/braze\/configuration-swift.class\/useuuidasdeviceid"},"doc://Braze/documentation/BrazeKit/Braze/enabled":{"url":"\/documentation\/brazekit\/braze\/enabled","kind":"symbol","title":"enabled","type":"topic","abstract":[{"type":"text","text":"Specify whether the Braze SDK is enabled or not."}],"role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"enabled"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/enabled"},"doc://Braze/documentation/BrazeKit/BrazeDelegate":{"role":"symbol","kind":"symbol","type":"topic","navigatorTitle":[{"text":"BrazeDelegate","kind":"identifier"}],"title":"BrazeDelegate","url":"\/documentation\/brazekit\/brazedelegate","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BrazeDelegate","kind":"identifier"}],"abstract":[{"type":"text","text":"Delegate for "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze"},{"type":"text","text":" that can optionally react to the SDK lifecycle events (e.g. SDK opening"},{"type":"text","text":" "},{"type":"text","text":"a URL, presenting a web view, etc.)"}],"identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/BrazeDelegate"},"doc://Braze/documentation/BrazeKit":{"title":"BrazeKit","abstract":[{"type":"text","text":"The main Braze framework providing user sessions, attributes and events logging, push notification support."}],"kind":"symbol","role":"collection","type":"topic","url":"\/documentation\/brazekit","identifier":"doc:\/\/