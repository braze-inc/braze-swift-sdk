{"kind":"article","primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In "},{"type":"codeVoice","code":"BrazeKit"},{"type":"text","text":", a user can be identified using one of two device ID options:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Apple’s "},{"isActive":true,"type":"reference","identifier":"https:\/\/developer.apple.com\/documentation\/uikit\/uidevice\/1620059-identifierforvendor"},{"type":"text","text":" property."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A randomly generated UUID."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Because "},{"type":"codeVoice","code":"identifierForVendor"},{"type":"text","text":" may not be available in all scenarios or devices, Braze provides the option to use a more generic UUID to identify a user’s device."}]},{"anchor":"Setting-Your-Configuration","text":"Setting Your Configuration","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"To configure this option, set ","type":"text"},{"type":"reference","identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/Configuration-swift.class\/useUUIDAsDeviceId","isActive":true},{"text":" under ","type":"text"},{"type":"codeVoice","code":"Braze.Configuration"},{"text":". Assigning this property to ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" will generate a random UUID for each user installation, whereas a value of ","type":"text"},{"type":"codeVoice","code":"false"},{"text":" will notify the SDK to use the device’s ","type":"text"},{"type":"codeVoice","code":"identifierForVendor"},{"text":".","type":"text"}]},{"code":["let configuration = Braze.Configuration(","    apiKey: \"<BRAZE_API_KEY>\",","    endpoint: \"<BRAZE_ENDPOINT>\"",")","\/\/ Set this value to `true` to opt out of `identifierForVendor` usage.","configuration.useUUIDAsDeviceId = true","let braze = Braze(configuration: configuration)"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Starting in 7.0.0, the default value for this property is "},{"type":"codeVoice","code":"true"},{"type":"text","text":"."}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"For device types that do not support ","type":"text"},{"code":"identifierForVendor","type":"codeVoice"},{"text":", such as watchOS or macOS, Braze will default to a randomly generated UUID regardless of which option is configured.","type":"text"}]}],"style":"note","name":"Note","type":"aside"},{"type":"paragraph","inlineContent":[{"text":"After being generated, device IDs created from UUIDs will remain consistent throughout the lifetime of the application’s installation or until ","type":"text"},{"type":"reference","identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/wipeData()","isActive":true},{"text":" is called.","type":"text"}]},{"content":[{"inlineContent":[{"text":"Since calling ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/wipeData()"},{"text":" will erase all local SDK storage, the device ID that was previously stored will be deleted. Thus, if ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/Configuration-swift.class\/useUUIDAsDeviceId"},{"text":" is enabled, the SDK will generate a new UUID for the device ID after this operation. Similarly, if ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/Configuration-swift.class\/useUUIDAsDeviceId"},{"text":" is disabled, the SDK will re-use the same IDFV after this operation.","type":"text"}],"type":"paragraph"}],"style":"important","name":"Important","type":"aside"},{"level":2,"type":"heading","text":"Migrating from a Previous Version","anchor":"Migrating-from-a-Previous-Version"},{"inlineContent":[{"text":"If you are migrating your project from the legacy ","type":"text"},{"isActive":true,"identifier":"https:\/\/github.com\/Appboy\/appboy-ios-sdk","type":"reference"},{"text":" or from a version of the Braze Swift SDK prior to ","type":"text"},{"code":"5.7.0","type":"codeVoice"},{"text":", note that the ","type":"text"},{"code":"identifierForVendor","type":"codeVoice"},{"text":" option will be used by default, regardless of the configuration setting. This ensures continuity for any anonymous users previously identified by the ","type":"text"},{"code":"identifierForVendor","type":"codeVoice"},{"text":" device ID.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"In such cases, if you wish to override those pre-existing values and ensure that your "},{"type":"reference","identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/Configuration-swift.class\/useUUIDAsDeviceId","isActive":true},{"type":"text","text":" configuration is respected, call "},{"type":"reference","identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/wipeData()","isActive":true},{"type":"text","text":" on the "},{"type":"codeVoice","code":"Braze"},{"type":"text","text":" instance after migrating to any version of the Braze Swift SDK from "},{"type":"codeVoice","code":"5.7.0"},{"type":"text","text":" onwards."}],"type":"paragraph"}],"kind":"content"}],"seeAlsoSections":[{"title":"Customize Behavior","anchor":"Customize-Behavior","generated":true,"identifiers":["doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/Configuration-swift.class","doc:\/\/Braze\/documentation\/BrazeKit\/BrazeDelegate","doc:\/\/Braze\/documentation\/BrazeKit\/overrideResourceBundle"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Braze\/documentation\/Braze\/device-id-configuration"},"metadata":{"role":"article","modules":[{"name":"BrazeKit"}],"roleHeading":"Article","title":"Device ID Configuration"},"hierarchy":{"paths":[["doc:\/\/Braze\/documentation\/BrazeKit"]]},"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"text":"Configuring your user’s device ID with ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/Configuration-swift.class\/useUUIDAsDeviceId"},{"text":".","type":"text"}],"references":{"doc://Braze/documentation/BrazeKit/Braze/wipeData()":{"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"wipeData"},{"kind":"text","text":"()"}],"url":"\/documentation\/brazekit\/braze\/wipedata()","title":"wipeData()","abstract":[{"type":"text","text":"Deletes all locally stored SDK data and sets "},{"identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/enabled","isActive":true,"type":"reference"},{"type":"text","text":" to "},{"code":"false","type":"codeVoice"},{"type":"text","text":"."}],"type":"topic","identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/wipeData()"},"doc://Braze/documentation/BrazeKit/Braze/enabled":{"identifier":"doc:\/\/Braze\/documentation\/BrazeKit\/Braze\/enabled","role":"symbol","title":"enabled","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"enabled"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"type":"topic","url":"\/documentation\/brazekit\/braze\/enabled","kind":"symbol","abstract":[{"type":"text","text":"Specify whether the Braze SDK is enabled or not."}]},"doc://Braze/documentation/BrazeKit":{"role":"collection","title":"BrazeKit","type":"topic","identifier":"doc:\/\/Braze\/documentation\/BrazeKit","kind":"symbol","url":"\/documentation\/brazekit","abstract":[{"type":"text","text":"The main Braze framework providing user sessions, attributes and events logging, push notification support."}]},"doc://Braze/documentation/BrazeKit/BrazeDelegate":{"url":"\/documentatio